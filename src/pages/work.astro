                <div class="flex gap-3">
                   {project.link && (
                     <a href={project.link} target="_blank" rel="noopener noreferrer" class="opacity-40 hover:opacity-100 transition-opacity px-1 py-1" aria-label="Visit Link">
                       <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
                     </a>
                   )}
                   {project.github && (
                     <a href={`https://github.com/${project.github}`} target="_blank" rel="noopener noreferrer" class="opacity-40 hover:opacity-100 transition-opacity px-1 py-1" aria-label="GitHub">
                       <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
                     </a>
                   )}
                </div>
              </div>
              <p class="text-sm opacity-70 mb-4 leading-relaxed font-light">
                {project.description}
              </p>
            </div>
            
            <div class="flex flex-wrap gap-2 mt-auto pt-4 border-t border-dashed border-current/10">
              {project.tags.map(tag => (
                <span class="text-[10px] opacity-50 px-2 py-1 bg-current/5 rounded-md">
                  {tag}
                </span>
              ))}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Designs Section -->
  <section id="designs-section" class="container mx-auto px-4 py-16 max-w-6xl section-content hidden">
    <div class="grid md:grid-cols-2 gap-8">
      {designs.map((designId, index) => (
        <div class="rounded-xl overflow-hidden bg-subtle animate-on-scroll" data-index={index}>
          <iframe 
            src={`https://www.behance.net/embed/project/${designId}?ilo0=1`}
            height="316" 
            allowfullscreen 
            loading="lazy"
            allow="clipboard-write" 
            referrerpolicy="strict-origin-when-cross-origin"
            class="w-full"
          ></iframe>
        </div>
      ))}
    </div>
  </section>

  <!-- Shots Section -->
  <section id="shots-section" class="container mx-auto px-4 py-16 max-w-6xl section-content hidden">
    <div class="columns-1 sm:columns-2 lg:columns-3 gap-4 space-y-4">
      {allShots.map((shot, index) => (
        <div class="break-inside-avoid animate-on-scroll" data-index={index}>
          <img 
            src={shot} 
            alt="photography shot"
            class="w-full rounded-lg hover:opacity-90 transition-opacity cursor-pointer"
            loading="lazy"
          />
        </div>
      ))}
    </div>
