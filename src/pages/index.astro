---
import BaseLayout from '../layouts/BaseLayout.astro';

const projects = [
  {
    title: 'JabWeMeet',
    description: 'multilingual live video conferencing built at 36hr national hackathon (because the world needs more ways to awkwardly stare at each other through screens)',
    demo: 'https://jabwemeet.vercel.app/',
    github: 'https://github.com/swasthikshetty10/hackoverflow',
    image: '/projects/jab-we-meet.jpg',
  },
  {
    title: "Incridea'23",
    description: "a complete event management & paperless system for nmamit's college fest. ",
    demo: 'https://incridea.in',
    github: 'https://github.com/incridea-nmamit/incridea-client/tree/2023',
    image: '/projects/incridea.jpg',
  },
  {
    title: 'Aido',
    description: 'A 3D multilingual chatbot that gestures while it talks. Finally, therapy that waves back.',
    demo: 'https://aido-clone.vercel.app/',
    github: 'https://github.com/nagarajpandith/aido',
    image: '/projects/aido.jpg',
  }
];

const blogs = [
  {
    title: 'honest guide to campus placements in software engineering',
    description: 'a practical roadmap for securing your dream job from campus placements',
    date: 'aug 4, 2024',
    views: '3312',
    readTime: '12 min',
    tags: ['campus placements', 'software engineering', 'career guide'],
    slug: 'placement-guide'
  },
  {
    title: 'starting web development the right way in 2021',
    description: 'a comprehensive guide to navigate the overwhelming world of web development resources and roadmaps',
    date: 'sep 4, 2021',
    views: '1114',
    readTime: '12 min',
    tags: ['webdev', 'roadmap', 'frontend'],
    slug: 'web-dev-roadmap'
  },
  {
    title: 'has anyone seen web3? — the complete roadmap',
    description: "twitter went crazy when musk and dorsey mocked web3. here's what it actually is",
    date: 'jan 8, 2022',
    views: '38821',
    readTime: '7 min',
    tags: ['web3', 'blockchain', 'solidity'],
    slug: 'web3-roadmap'
  }
];
---

<BaseLayout title="nagaraj pandith - full-stack developer">
  <!-- Hero Section -->
  <section class="container md:pt-32 pt-24 pb-24 md:pb-32 max-w-5xl">
    <div class="space-y-12">
      <h1 class="reveal-text font-serif text-6xl md:text-8xl lg:text-9xl mb-8 tracking-tighter text-[var(--color-text-primary)] leading-[0.9]">
        nagaraj <br class="md:hidden" /> pandith.
      </h1>
      
      <div class="reveal-text text-xl md:text-2xl leading-relaxed max-w-2xl space-y-8 font-light text-[var(--color-text-muted)] italic">
        <p>
          full-stack developer crafting meaningful software & <br class="hidden md:block" />
          thoughtful digital experiences.
        </p>
        
        <p class="text-lg not-italic opacity-60">
          obsessed with documentation, debugging, and the small <br class="hidden md:block" /> details that define the whole.
        </p>
      </div>

      <div class="reveal-text flex flex-wrap gap-8 pt-8 items-center">
        <a href="/work" class="btn-primary">
          See my projects
        </a>
        <a href="/about" class="link text-lg text-[var(--color-text-muted)] hover:text-[var(--color-text-primary)] transition-colors">
          more about me
        </a>
      </div>
    </div>
  </section>

  <!-- Currently Section -->
  <section class="container py-24 border-t border-[var(--color-border)]">
    <div class="grid md:grid-cols-4 gap-12">
      <div class="md:col-span-1 reveal-text">
        <h2 class="text-label mb-6">currently</h2>
      </div>
      <div class="md:col-span-3 grid md:grid-cols-3 gap-12">
        <div class="reveal-text">
          <h3 class="font-medium mb-3 text-[var(--color-text-primary)] tracking-wide">building (freelance)</h3>
          <p class="text-sm text-[var(--color-text-muted)] leading-relaxed">
            end-to-end ecommerce system with storefront and fully customizable dashboard
          </p>
        </div>
        <div class="reveal-text">
          <h3 class="font-medium mb-3 text-[var(--color-text-primary)] tracking-wide">building (side project)</h3>
          <p class="text-sm text-[var(--color-text-muted)] leading-relaxed">
            ar + llm app idea. still in planning phase. if things go downhill, at least i'll learn flutter & ar
          </p>
        </div>
        <div class="reveal-text">
          <h3 class="font-medium mb-3 text-[var(--color-text-primary)] tracking-wide">learning</h3>
          <p class="text-sm text-[var(--color-text-muted)] leading-relaxed">
            htmx, golang stack and exploring agentic ai
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Work -->
  <section class="container py-24 border-t border-[var(--color-border)]">
    <div class="flex flex-col sm:flex-row sm:justify-between sm:items-end gap-4 mb-20">
      <div class="reveal-text">
        <h2 class="text-label mb-4">selected works</h2>
        <h3 class="font-serif text-4xl md:text-5xl text-[var(--color-text-primary)]">featured work</h3>
      </div>
      <a href="/work" class="link text-sm text-[var(--color-text-muted)] hover:text-[var(--color-text-primary)] pb-1 border-b border-transparent hover:border-current">view all work →</a>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-16">
      {projects.map((project) => (
        <article class="group reveal-text flex flex-col">
          <a href={project.demo} target="_blank" rel="noopener noreferrer" class="block mb-6">
            <div class="relative overflow-hidden aspect-video bg-[var(--color-bg-secondary)] rounded-sm border border-[var(--color-border)]">
              <img 
                src={project.image} 
                alt={project.title}
                class="w-full h-full object-cover grayscale opacity-60 group-hover:grayscale-0 group-hover:opacity-100 group-hover:scale-105 transition-all duration-700 ease-out"
              />
            </div>
          </a>
          <div class="flex flex-col flex-1">
            <div class="flex items-center justify-between mb-3">
              <h3 class="font-serif text-xl tracking-tight text-[var(--color-text-primary)]">
                {project.title}
              </h3>
              <div class="flex gap-4 text-xs opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                <a href={project.demo} target="_blank" rel="noopener noreferrer" class="link border-b border-current">demo</a>
                <a href={project.github} target="_blank" rel="noopener noreferrer" class="link border-b border-current text-[var(--color-text-muted)]">code</a>
              </div>
            </div>
            <p class="text-sm text-[var(--color-text-muted)] leading-relaxed font-light">
              {project.description}
            </p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- Latest Writings -->
  <section class="container py-24 border-t border-[var(--color-border)]">
    <div class="flex flex-col sm:flex-row sm:justify-between sm:items-end gap-4 mb-20">
      <div class="reveal-text">
        <h2 class="text-label mb-4">thoughts</h2>
        <h3 class="font-serif text-4xl md:text-5xl text-[var(--color-text-primary)]">latest writings</h3>
      </div>
      <a href="/blog" class="link text-sm text-[var(--color-text-muted)] hover:text-[var(--color-text-primary)] pb-1 border-b border-transparent hover:border-current">all posts →</a>
    </div>

    <div class="space-y-12">
      {blogs.map((blog) => (
        <article class="group reveal-text">
          <a href={`/blog/${blog.slug}`} class="grid md:grid-cols-4 gap-4 md:gap-12 items-start py-4 group-hover:bg-[var(--color-bg-secondary)] transition-colors rounded-lg -mx-4 px-4">
            <div class="md:col-span-1 pt-1">
              <span class="text-xs text-[var(--color-text-muted)] tracking-widest uppercase">{blog.date}</span>
            </div>
            <div class="md:col-span-3">
              <div class="flex flex-col md:flex-row md:justify-between md:items-baseline gap-2 mb-2">
                <h3 class="text-xl md:text-2xl font-serif text-[var(--color-text-primary)] group-hover:text-[var(--color-accent)] transition-colors">
                  {blog.title}
                </h3>
                <div class="flex items-center gap-3 text-[10px] uppercase tracking-[0.2em] text-[var(--color-text-muted)] opacity-60 shrink-0">
                  <span>{blog.views} views</span>
                  <span class="w-1 h-1 rounded-full bg-current"></span>
                  <span>{blog.readTime} read</span>
                </div>
              </div>
              <p class="text-sm md:text-base text-[var(--color-text-muted)] opacity-80 font-light leading-relaxed max-w-2xl mb-4">
                {blog.description}
              </p>
              <div class="flex flex-wrap items-center gap-4">
                {blog.tags.map(tag => (
                  <span class="text-[10px] uppercase tracking-widest text-[var(--color-text-muted)] opacity-60 px-2 py-0.5 border border-[var(--color-border)] rounded-full">
                    {tag}
                  </span>
                ))}
              </div>
            </div>
          </a>
        </article>
      ))}
    </div>
  </section>

  <!-- CTA Section -->
  <section id="contact" class="container py-32 border-t border-[var(--color-border)]">
    <div class="grid md:grid-cols-2 gap-12 items-center">
      <div>
        <h2 class="reveal-text text-label mb-6">get in touch</h2>
        <h3 class="reveal-text font-serif text-4xl md:text-5xl text-[var(--color-text-primary)] mb-8 leading-tight">
          got a project <br /> in mind?
        </h3>
      </div>
      <div>
        <p class="text-xl text-[var(--color-text-muted)] mb-12 font-light leading-relaxed">
          whether it's a startup idea, a college fest website, or just a chat over chocolate ice cream — i'm all ears.
        </p>
        <div class="reveal-text flex flex-wrap gap-12 items-center">
          <a href="https://www.discord.com/users/hashclan#4890" target="_blank" rel="noopener noreferrer" class="link text-xl border-b-2 border-current pb-1 hover:text-[var(--color-accent)] transition-colors">
            let's work together
          </a>
          <a href="mailto:nagaraj.pandith2002@gmail.com" class="link text-xl text-[var(--color-text-muted)] hover:text-[var(--color-text-primary)] transition-opacity">
            send an email
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>