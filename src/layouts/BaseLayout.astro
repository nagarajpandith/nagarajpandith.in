---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
}

const { 
  title, 
  description = "full-stack developer who gets unreasonably excited about clean code and user delight. bribery accepted in chocolate ice cream or biryani." 
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content={description}>
  
  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  
  <!-- RSS Feed -->
  <link rel="alternate" type="application/rss+xml" title="nagaraj pandith - blog" href="/rss.xml" />
  
  <!-- Open Graph / Social Media -->
  <meta property="og:type" content="website">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  
  <title>{title}</title>

  <script is:inline>
    // Theme initialization - immediate execution to prevent flash
    const theme = (() => {
      if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
        return localStorage.getItem('theme');
      }
      return 'dark'; // Default
    })();
    
    if (theme === 'light') {
      document.body.classList.add('light');
    } else {
      document.body.classList.remove('light');
    }
  </script>
</head>
<body>
  <Header />
  
  <!-- Content Grid Background -->
  <div class="fixed inset-0 pointer-events-none z-0 flex justify-center">
    <div class="w-full h-full max-w-[var(--spacing-container)] px-2">
      <!-- Border-x at px-2 provides ample breathing room outside the px-6 content padding -->
      <div class="h-full w-full grid grid-cols-1 md:grid-cols-4 border-x border-dashed border-[var(--color-grid)]">
        <div class="hidden md:block border-r border-dashed border-[var(--color-grid)] h-full"></div>
        <div class="hidden md:block border-r border-dashed border-[var(--color-grid)] h-full"></div>
        <div class="hidden md:block border-r border-dashed border-[var(--color-grid)] h-full"></div>
        <div class="hidden md:block h-full"></div>
      </div>
    </div>
  </div>

  <main class="min-h-screen relative z-10">
    <slot />
  </main>
  
  <Footer />
  

</body>
</html>