          </div>

          <!-- Project Details -->
          <div class="flex-1 flex flex-col">
            <div class="flex items-start justify-between mb-4">
              <h2 class="text-2xl font-medium heading-handwritten">
                {project.title}
              </h2>
              <div class="flex gap-2">
                <a 
                  href={project.link} 
                  target="_blank" 
                  rel="noopener noreferrer"
                  aria-label="View Live"
                  class="p-2 rounded-lg hover:bg-current/5 opacity-50 hover:opacity-100 transition-all"
