---
import BaseLayout from '../layouts/BaseLayout.astro';

const projects = [
  {
    title: 'JabWeMeet',
    description: 'multilingual live video conferencing built at 36hr national hackathon (because the world needs more ways to awkwardly stare at each other through screens)',
    demo: 'https://jabwemeet.vercel.app/',
    github: 'https://github.com/swasthikshetty10/hackoverflow',
    image: '/projects/jab-we-meet.jpg',
  },
  {
    title: "Incridea'23",
    description: "a complete event management & paperless system for nmamit's college fest. ",
    demo: 'https://incridea.in',
    github: 'https://github.com/incridea-nmamit/incridea-client/tree/2023',
    image: '/projects/incridea.jpg',
  },
  {
    title: 'Aido',
    description: 'A 3D multilingual chatbot that gestures while it talks. Finally, therapy that waves back.',
    demo: 'https://aido-clone.vercel.app/',
    github: 'https://github.com/nagarajpandith/aido',
    image: '/projects/aido.jpg',
  }
];

const blogs = [
  {
    title: 'honest guide to campus placements in software engineering',
    description: 'a practical roadmap for securing your dream job from campus placements',
    date: 'aug 4, 2024',
    views: '3312',
    readTime: '12 min',
    tags: ['campus placements', 'software engineering', 'career guide'],
    slug: 'placement-guide'
  },
  {
    title: 'starting web development the right way in 2021',
    description: 'a comprehensive guide to navigate the overwhelming world of web development resources and roadmaps',
    date: 'sep 4, 2021',
    views: '1114',
    readTime: '12 min',
    tags: ['webdev', 'roadmap', 'frontend'],
    slug: 'web-dev-roadmap'
  },
  {
    title: 'has anyone seen web3? — the complete roadmap',
    description: "twitter went crazy when musk and dorsey mocked web3. here's what it actually is",
    date: 'jan 8, 2022',
    views: '38821',
    readTime: '7 min',
    tags: ['web3', 'blockchain', 'solidity'],
    slug: 'web3-roadmap'
  }
];
---

<BaseLayout title="nagaraj pandith - full-stack developer">
  <!-- Hero Section -->
  <section class="container mx-auto px-4 py-32 md:py-48 max-w-4xl">
    <div class="animate-on-scroll space-y-12">
      <h1 class="heading-handwritten text-5xl md:text-6xl mb-4 opacity-80">
        nagaraj pandith
      </h1>
      
      <div class="text-xl md:text-2xl opacity-90 leading-relaxed max-w-3xl space-y-8 font-light italic">
        <p>
          full-stack developer who codes, creates, and occasionally writes. <br class="hidden md:block" />
          i get my dopamine from crafting innovative solutions and shipping thoughtful side projects.
        </p>
        
        <p class="opacity-60 text-lg not-italic">
          obsessed with documentation, debugging, and details most people overlook. <br class="hidden md:block" />
          always open to interesting problems.
        </p>
      </div>

      <div class="flex flex-wrap gap-8 pt-8 items-center">
        <a href="/freelance" class="link text-lg border-b border-current pb-1">
          let's build something
        </a>
        <a href="/about" class="link text-lg opacity-60 hover:opacity-100 transition-opacity">
          more about me
        </a>
      </div>
    </div>
  </section>

  <!-- Currently Section -->
  <section class="container mx-auto px-4 py-24 max-w-6xl animate-on-scroll border-t border-white/5 pt-24">
    <div class="grid md:grid-cols-4 gap-12">
      <div class="md:col-span-1">
        <h2 class="text-xs uppercase tracking-[0.2em] opacity-40 font-semibold mb-6">currently</h2>
      </div>
      <div class="md:col-span-3 grid md:grid-cols-3 gap-12">
        <div>
          <h3 class="text-sm font-medium mb-3 opacity-90 tracking-wide">building (freelance)</h3>
          <p class="text-sm opacity-50 leading-relaxed">
            end-to-end ecommerce system with storefront and fully customizable dashboard
          </p>
        </div>
        <div>
          <h3 class="text-sm font-medium mb-3 opacity-90 tracking-wide">building (side project)</h3>
          <p class="text-sm opacity-50 leading-relaxed">
            ar + llm app idea. still in planning phase. if things go downhill, at least i'll learn flutter & ar
          </p>
        </div>
        <div>
          <h3 class="text-sm font-medium mb-3 opacity-90 tracking-wide">learning</h3>
          <p class="text-sm opacity-50 leading-relaxed">
            htmx, golang stack and exploring agentic ai
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Work -->
  <section class="container mx-auto px-4 py-24 max-w-6xl animate-on-scroll border-t border-white/5">
    <div class="flex flex-col sm:flex-row sm:justify-between sm:items-end gap-4 mb-20">
      <div>
        <h2 class="text-xs uppercase tracking-[0.2em] opacity-40 font-semibold mb-4">selected works</h2>
        <h3 class="heading-handwritten text-4xl md:text-5xl opacity-80">featured work</h3>
      </div>
      <a href="/work" class="link text-sm opacity-50 hover:opacity-100 transition-opacity pb-1 border-b border-transparent hover:border-current">view all work →</a>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-16">
      {projects.map((project) => (
        <article class="group animate-on-scroll flex flex-col">
          <a href={project.demo} target="_blank" rel="noopener noreferrer" class="block mb-6">
            <div class="relative overflow-hidden aspect-video bg-subtle rounded-sm">
              <img 
                src={project.image} 
                alt={project.title}
                class="w-full h-full object-cover grayscale opacity-40 group-hover:grayscale-0 group-hover:opacity-100 group-hover:scale-105 transition-all duration-700 ease-out"
              />
            </div>
          </a>
          <div class="flex flex-col flex-1">
            <div class="flex items-center justify-between mb-3">
              <h3 class="font-medium text-lg tracking-tight">
                {project.title}
              </h3>
              <div class="flex gap-4 text-xs opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                <a href={project.demo} target="_blank" rel="noopener noreferrer" class="link border-b border-current">demo</a>
                <a href={project.github} target="_blank" rel="noopener noreferrer" class="link border-b border-current opacity-60">code</a>
              </div>
            </div>
            <p class="text-sm opacity-50 leading-relaxed font-light">
              {project.description}
            </p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- Latest Writings -->
  <section class="container mx-auto px-4 py-24 max-w-6xl animate-on-scroll border-t border-white/5">
    <div class="flex flex-col sm:flex-row sm:justify-between sm:items-end gap-4 mb-20">
      <div>
        <h2 class="text-xs uppercase tracking-[0.2em] opacity-40 font-semibold mb-4">thoughts</h2>
        <h3 class="heading-handwritten text-4xl md:text-5xl opacity-80">latest writings</h3>
      </div>
      <a href="/blog" class="link text-sm opacity-50 hover:opacity-100 transition-opacity pb-1 border-b border-transparent hover:border-current">all posts →</a>
    </div>

    <div class="space-y-12">
      {blogs.map((blog) => (
        <article class="group animate-on-scroll">
          <a href={`/blog/${blog.slug}`} class="grid md:grid-cols-4 gap-4 md:gap-12 items-start py-4">
            <div class="md:col-span-1">
              <span class="text-xs opacity-30 tracking-widest uppercase">{blog.date}</span>
            </div>
            <div class="md:col-span-3">
              <div class="flex flex-col md:flex-row md:justify-between md:items-baseline gap-2 mb-4">
                <h3 class="text-xl md:text-2xl font-light group-hover:opacity-60 transition-opacity">
                  {blog.title}
                </h3>
                <div class="flex items-center gap-3 text-[10px] uppercase tracking-[0.2em] opacity-30 shrink-0">
                  <span>{blog.views} views</span>
                  <span class="w-1 h-1 rounded-full bg-current"></span>
                  <span>{blog.readTime} read</span>
                </div>
              </div>
              <p class="text-sm md:text-base opacity-50 font-light leading-relaxed max-w-2xl mb-6">
                {blog.description}
              </p>
              <div class="flex flex-wrap items-center gap-4">
                {blog.tags.map(tag => (
                  <span class="text-[10px] uppercase tracking-widest opacity-40 px-2 py-0.5 border border-white/10 rounded-full group-hover:border-white/20 transition-colors">
                    {tag}
                  </span>
                ))}
              </div>
            </div>
          </a>
        </article>
      ))}
    </div>
  </section>

  <!-- CTA Section -->
  <section class="container mx-auto px-4 py-32 max-w-6xl animate-on-scroll border-t border-white/5">
    <div class="grid md:grid-cols-2 gap-12 items-center">
      <div>
        <h2 class="text-xs uppercase tracking-[0.2em] opacity-40 font-semibold mb-6">get in touch</h2>
        <h3 class="heading-handwritten text-4xl md:text-5xl opacity-80 mb-8 leading-tight">
          got a project <br /> in mind?
        </h3>
      </div>
      <div>
        <p class="text-xl opacity-50 mb-12 font-light leading-relaxed">
          whether it's a startup idea, a college fest website, or just a chat over chocolate ice cream — i'm all ears.
        </p>
        <div class="flex flex-wrap gap-12 items-center">
          <a href="/freelance" class="link text-xl border-b-2 border-current pb-1">
            let's work together
          </a>
          <a href="mailto:nagaraj.pandith2002@gmail.com" class="link text-xl opacity-60 hover:opacity-100 transition-opacity">
            send an email
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  body.light article {
    border-color: rgba(62, 39, 35, 0.1) !important;
  }
</style>