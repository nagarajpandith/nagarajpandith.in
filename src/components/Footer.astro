---
const currentYear = new Date().getFullYear();
---

<footer class="border-t mt-20" style="border-color: rgba(255, 255, 255, 0.1);">
  <div class="container mx-auto px-4 py-12 max-w-6xl">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <!-- About Section -->
      <div>
        <h3 class="heading-handwritten mb-4" style="font-size: 1.25rem;">nagaraj pandith</h3>
        <p class="text-sm opacity-70 mb-4">
          crafting digital experiences that don't make users ragequit. one line of code at a time.
        </p>
      </div>
      
      <!-- Quick Links -->
      <div>
        <h4 class="font-medium mb-4">explore</h4>
        <ul class="space-y-2 text-sm">
          <li><a href="/about" class="link">about</a></li>
          <li><a href="/work" class="link">work</a></li>
          <li><a href="/blog" class="link">blog</a></li>
          <li><a href="/notes" class="link">notes</a></li>
          <li><a href="/tools" class="link">tools</a></li>
          <li><a href="/recommendations" class="link">recommendations</a></li>
          <li><a href="/guestbook" class="link">guestbook</a></li>
          <li><a href="/resume.pdf" target="_blank" class="link">resume</a></li>
        </ul>
      </div>
      
      <!-- Social Links & Resources -->
      <div>
        <h4 class="font-medium mb-4">connect</h4>
        <div class="flex flex-wrap gap-4 text-sm mb-6">
          <a 
            href="https://github.com/yourusername" 
            target="_blank"
            rel="noopener noreferrer"
            class="link flex items-center gap-1"
            aria-label="GitHub"
