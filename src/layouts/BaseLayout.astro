---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
}

const { 
  title, 
  description = "full-stack developer who gets unreasonably excited about clean code and user delight. bribery accepted in chocolate ice cream or biryani." 
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content={description}>
  
  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  
  <!-- RSS Feed -->
  <link rel="alternate" type="application/rss+xml" title="nagaraj pandith - blog" href="/rss.xml" />
  
  <!-- Open Graph / Social Media -->
  <meta property="og:type" content="website">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  
  <title>{title}</title>

  <script>
    import Lenis from 'lenis'
    import { animate, inView, stagger } from 'motion'

    // --- Core Initialization ---
    const lenis = new Lenis({
      lerp: 0.1,
      wheelMultiplier: 1.2,
      smoothWheel: true,
    })

    function raf(time: number) {
      lenis.raf(time)
      requestAnimationFrame(raf)
    }
    requestAnimationFrame(raf)

    // --- Split Text Utility ---
    function splitTextContent() {
      const elements = document.querySelectorAll('.split-text');
      elements.forEach(el => {
        const text = el.textContent || '';
        el.innerHTML = '';
        [...text].forEach(char => {
          const span = document.createElement('span');
          span.textContent = char === ' ' ? '\u00A0' : char;
          span.style.display = 'inline-block';
          span.classList.add('char');
          el.appendChild(span);
        });
      });
    }

    // --- Interaction States ---
    function setupInteractions() {
      // 1. Text Reveals
      inView('.reveal-text', (element) => {
        const el = element as HTMLElement;
        el.style.visibility = 'visible';
        animate(element, { 
          opacity: [0, 1], y: [20, 0], filter: ['blur(8px)', 'blur(0px)']
        }, { duration: 0.8, ease: [0.17, 0.55, 0.55, 1] });
        return () => {
          animate(element, { opacity: 0, y: 20, filter: 'blur(8px)' }, { duration: 0 });
          el.style.visibility = 'hidden';
        };
      });

      // 2. Character Reveals (Hero)
      inView('.split-text', (element) => {
        const el = element as HTMLElement;
        el.style.visibility = 'visible';
        const chars = element.querySelectorAll('.char');
        animate(chars, { 
          opacity: [0, 1], y: [20, 0], filter: ['blur(4px)', 'blur(0px)']
        }, { delay: stagger(0.04), duration: 0.6, ease: [0.2, 0.65, 0.3, 0.9] });
      });

      // 3. Magnetic Effects
      document.querySelectorAll('.magnetic').forEach(el => {
        const element = el as HTMLElement;
        element.addEventListener('mousemove', (e: MouseEvent) => {
          const { left, top, width, height } = element.getBoundingClientRect();
          const centerX = left + width / 2, centerY = top + height / 2;
          animate(element, { x: (e.clientX - centerX) * 0.3, y: (e.clientY - centerY) * 0.3 }, { duration: 0 });
        });
        element.addEventListener('mouseleave', () => {
          animate(element, { x: 0, y: 0 }, { duration: 0.5, ease: [0.17, 0.67, 0.83, 0.67] });
        });
      });
    }

    // Initialize
    document.addEventListener('DOMContentLoaded', () => {
      splitTextContent();
      setupInteractions();
    });

    // Theme Support
    const getTheme = () => localStorage.getItem('theme') || 'dark';
    const applyTheme = (t: string) => document.body.classList.toggle('light', t === 'light');
    applyTheme(getTheme());

    // Astro View Transitions Support
    document.addEventListener('astro:after-swap', () => {
      applyTheme(getTheme());
      splitTextContent();
      setupInteractions();
    });
  </script>
</head>
<body>
  <div class="grain-overlay"></div>
  <!-- Top Gradient Guard: Content fades out as it scrolls up -->
  <div class="fixed top-0 left-0 right-0 h-32 md:h-48 z-[115] pointer-events-none bg-gradient-to-b from-[var(--color-bg-primary)] via-[var(--color-bg-primary)]/80 to-transparent"></div>

  <Header />
  
  <!-- Content Grid Background -->
  <div class="fixed inset-0 pointer-events-none z-0 flex justify-center">
    <div class="w-full h-full max-w-[var(--spacing-container)] px-2">
      <!-- Border-x at px-2 provides ample breathing room outside the px-6 content padding -->
      <div class="h-full w-full grid grid-cols-1 md:grid-cols-4 border-x border-dashed border-[var(--color-grid)]">
        <div class="hidden md:flex justify-end h-full">
          <div class="grid-line-v"></div>
        </div>
        <div class="hidden md:flex justify-end h-full">
          <div class="grid-line-v"></div>
        </div>
        <div class="hidden md:flex justify-end h-full">
          <div class="grid-line-v"></div>
        </div>
        <div class="hidden md:block h-full"></div>
      </div>
    </div>
  </div>

  <main class="min-h-screen relative z-10">
    <slot />
  </main>
  
  <Footer />

  <style is:global>
    .magnetic {
      display: inline-block;
      transition: transform 0.1s linear;
    }
    /* Animation Utilities */
    .reveal-text {
      opacity: 0;
      transform: translateY(20px);
      filter: blur(8px);
      visibility: hidden;
      will-change: opacity, transform, filter;
    }

    .split-text {
      visibility: hidden;
    }

    .stagger-link {
      opacity: 0;
      transform: translateY(20px);
    }

    /* Lenis Smooth Scroll */
    html.lenis, html.lenis body {
      height: auto;
    }

    .lenis.lenis-smooth {
      scroll-behavior: auto !important;
    }

    .lenis.lenis-smooth [data-lenis-prevent] {
      overscroll-behavior: contain;
    }

    .lenis.lenis-stopped {
      overflow: hidden;
    }

    .lenis.lenis-scrolling iframe {
      pointer-events: none;
    }
    /* Soft Static Texture (Paper Feel) */
    .grain-overlay {
      position: fixed;
      inset: 0;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 400 400' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3CfeColorMatrix type='saturate' values='0'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
      opacity: 0.16;
      pointer-events: none;
      z-index: 9999;
    }

    .light .grain-overlay {
      opacity: 0.4;
      mix-blend-mode: multiply; /* Crucial for visibility on light themes */
    }
  </style>

</body>
</html>