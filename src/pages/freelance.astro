---
import BaseLayout from '../layouts/BaseLayout.astro';

const services = [
  {
    title: 'websites & web apps',
    description: 'responsive, scalable, production-ready builds with modern frameworks',
    includes: [
      'landing pages that convert',
      'full-stack web applications',
      'e-commerce stores with custom dashboards',
      'performance optimization',
      'mobile-first design',
    ],
    icon: '🌐',
  },
  {
    title: 'hosting & setup',
    description: 'end-to-end setup so you can focus on your business',
    includes: [
      'domain registration & configuration',
      'professional email setup',
      'hosting & deployment',
      'ssl certificates',
      'dns management',
    ],
    icon: '🚀',
  },
  {
    title: 'graphic design',
    description: 'visual content that stands out',
    includes: [
      'social media posts (instagram, linkedin, twitter)',
      'event posters & flyers',
      'carousel designs',
      'thumbnails & banners',
      'brand consistency',
    ],
    icon: '🎨',
  },
  {
    title: 'light devops',
    description: 'smooth deployments and reliable infrastructure',
    includes: [
      'ci/cd pipeline setup',
      'docker containerization',
      'cloud deployment (aws, vercel, railway)',
      'monitoring & logging',
      'backup strategies',
    ],
    icon: '⚙️',
  },
];

const idealClients = [
  {
    type: 'startups & indie founders',
    description: 'turning ideas into mvps quickly',
    fit: 'you need to move fast and iterate',
  },
  {
    type: 'content creators & personal brands',
    description: 'building your online presence',
    fit: 'you want a portfolio that reflects your personality',
  },
  {
    type: 'small businesses',
    description: 'establishing credibility online',
    fit: 'you need a professional web presence',
  },
  {
    type: 'college fests / communities / events',
    description: 'event websites & registration systems',
    fit: 'you need something reliable and scalable',
  },
];

const process = [
  {
    step: '1',
    title: 'initial chat',
    description: 'we discuss your project, goals, timeline, and budget. no commitment yet.',
  },
  {
    step: '2',
    title: 'proposal & timeline',
    description: 'i send you a detailed proposal with scope, deliverables, and realistic timeline.',
  },
  {
    step: '3',
    title: 'design & development',
    description: 'regular updates, feedback loops, and transparent progress tracking.',
  },
  {
    step: '4',
    title: 'launch & support',
    description: 'smooth deployment, documentation, and post-launch support included.',
  },
];

const testimonials = [
  {
    text: 'working with nagaraj was seamless. he understood our vision and delivered beyond expectations.',
    author: 'startup founder',
    project: 'saas landing page',
  },
  {
    text: 'fast turnaround, clean code, and great communication. highly recommend!',
    author: 'tech lead',
    project: 'event management system',
  },
  {
    text: 'the attention to detail and user experience was impressive. our users love the new design.',
    author: 'product manager',
    project: 'dashboard redesign',
  },
];
---

<BaseLayout title="freelance - nagaraj pandith" description="let's build something great together">
  <!-- Hero -->
  <section class="container mx-auto px-4 py-20 max-w-4xl text-center animate-on-scroll">
    <h1 class="heading-handwritten text-5xl md:text-7xl mb-6">let's work together</h1>
    <p class="text-xl md:text-2xl opacity-90 mb-8 max-w-2xl mx-auto leading-relaxed">
      i help startups, creators, and businesses build web experiences that work beautifully and scale effortlessly
    </p>
    <div class="flex flex-wrap justify-center gap-4 mb-12">
      <a href="#services" class="btn-primary text-lg px-8 py-4">
        see what i do
      </a>
      <a href="#contact" class="btn-secondary text-lg px-8 py-4">
        get in touch
      </a>
    </div>
    <p class="text-sm opacity-50">
      currently accepting new projects • fast turnaround • transparent pricing
    </p>
  </section>

  <!-- Services -->
  <section id="services" class="container mx-auto px-4 py-16 max-w-6xl">
    <h2 class="heading-handwritten text-4xl md:text-5xl mb-12 text-center animate-on-scroll">
      what i do
    </h2>

    <div class="grid md:grid-cols-2 gap-8">
      {services.map((service) => (
        <article class="bg-opacity-5 rounded-2xl p-8 hover:bg-opacity-10 transition-all animate-on-scroll" style="background-color: currentColor;">
          <div class="text-5xl mb-4">{service.icon}</div>
          <h3 class="text-2xl font-medium mb-3">{service.title}</h3>
          <p class="opacity-70 mb-6">{service.description}</p>
          <ul class="space-y-2">
            {service.includes.map((item) => (
              <li class="flex items-start gap-2 text-sm opacity-80">
                <svg class="w-5 h-5 shrink-0 mt-0.5 opacity-50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                {item}
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </section>

  <!-- Ideal Clients -->
  <section class="container mx-auto px-4 py-16 max-w-4xl">
    <h2 class="heading-handwritten text-4xl md:text-5xl mb-4 text-center animate-on-scroll">
      ideal clients
    </h2>
    <p class="text-center opacity-70 mb-12 animate-on-scroll">
      i work best with people who value quality, clear communication, and user experience
    </p>

    <div class="grid sm:grid-cols-2 gap-6">
      {idealClients.map((client) => (
        <article class="bg-opacity-5 rounded-xl p-6 hover:bg-opacity-10 transition-all animate-on-scroll" style="background-color: currentColor;">
          <h3 class="font-medium text-lg mb-2">{client.type}</h3>
          <p class="text-sm opacity-70 mb-3">{client.description}</p>
          <p class="text-xs opacity-50 italic">perfect if: {client.fit}</p>
        </article>
      ))}
    </div>
  </section>

  <!-- Process -->
  <section class="container mx-auto px-4 py-16 max-w-4xl">
    <h2 class="heading-handwritten text-4xl md:text-5xl mb-12 text-center animate-on-scroll">
      how it works
    </h2>

    <div class="space-y-8">
      {process.map((item, index) => (
        <article class="flex gap-6 animate-on-scroll">
          <div class="shrink-0">
            <div class="w-12 h-12 rounded-full bg-opacity-10 flex items-center justify-center font-medium text-lg" style="background-color: currentColor;">
              {item.step}
            </div>
          </div>
          <div class="flex-1">
            <h3 class="font-medium text-xl mb-2">{item.title}</h3>
            <p class="opacity-70">{item.description}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- Testimonials -->
  <section class="container mx-auto px-4 py-16 max-w-5xl">
    <h2 class="heading-handwritten text-4xl md:text-5xl mb-12 text-center animate-on-scroll">
      kind words
    </h2>

    <div class="grid md:grid-cols-3 gap-6">
      {testimonials.map((testimonial) => (
        <blockquote class="bg-opacity-5 rounded-xl p-6 hover:bg-opacity-10 transition-all animate-on-scroll" style="background-color: currentColor;">
          <p class="opacity-80 mb-4 leading-relaxed">
            "{testimonial.text}"
          </p>
          <footer class="text-sm">
            <p class="font-medium">{testimonial.author}</p>
            <p class="opacity-50">{testimonial.project}</p>
          </footer>
        </blockquote>
      ))}
    </div>
  </section>

  <!-- Pricing Philosophy -->
  <section class="container mx-auto px-4 py-16 max-w-4xl">
    <div class="bg-opacity-5 rounded-2xl p-8 md:p-12 text-center animate-on-scroll" style="background-color: currentColor;">
      <h2 class="heading-handwritten text-3xl md:text-4xl mb-4">
        transparent pricing
      </h2>
      <p class="opacity-80 mb-6 max-w-2xl mx-auto">
        every project is unique, so i don't believe in one-size-fits-all pricing. after our initial chat, i'll send you a detailed proposal with clear deliverables and timeline.
      </p>
      <p class="text-sm opacity-60">
        ballpark: small projects start at ₹15k • medium projects ₹30k-60k • larger builds custom quoted
      </p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="container mx-auto px-4 py-16 max-w-4xl">
    <h2 class="heading-handwritten text-4xl md:text-5xl mb-12 text-center animate-on-scroll">
      common questions
    </h2>

    <div class="space-y-6">
      <details class="group bg-opacity-5 rounded-xl p-6 hover:bg-opacity-10 transition-all animate-on-scroll" style="background-color: currentColor;">
        <summary class="cursor-pointer font-medium flex items-center justify-between">
          how long does a typical project take?
          <svg class="w-5 h-5 transform group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
          </svg>
        </summary>
        <p class="mt-4 opacity-70 text-sm">
          landing pages: 1-2 weeks • full websites: 3-6 weeks • web apps: 6-12 weeks. i'll give you a realistic timeline upfront.
        </p>
      </details>

      <details class="group bg-opacity-5 rounded-xl p-6 hover:bg-opacity-10 transition-all animate-on-scroll" style="background-color: currentColor;">
        <summary class="cursor-pointer font-medium flex items-center justify-between">
          do you work with clients outside india?
          <svg class="w-5 h-5 transform group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
          </svg>
        </summary>
        <p class="mt-4 opacity-70 text-sm">
          absolutely! i've worked with clients across different timezones. async communication works great for most projects.
        </p>
      </details>

      <details class="group bg-opacity-5 rounded-xl p-6 hover:bg-opacity-10 transition-all animate-on-scroll" style="background-color: currentColor;">
        <summary class="cursor-pointer font-medium flex items-center justify-between">
          what if i need changes after launch?
          <svg class="w-5 h-5 transform group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
          </svg>
        </summary>
        <p class="mt-4 opacity-70 text-sm">
          all projects include 2 weeks of post-launch support for bug fixes. for ongoing updates, we can discuss a monthly retainer or per-update pricing.
        </p>
      </details>

      <details class="group bg-opacity-5 rounded-xl p-6 hover:bg-opacity-10 transition-all animate-on-scroll" style="background-color: currentColor;">
        <summary class="cursor-pointer font-medium flex items-center justify-between">
          do you offer payment plans?
          <svg class="w-5 h-5 transform group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
          </svg>
        </summary>
        <p class="mt-4 opacity-70 text-sm">
          yes! typically: 50% upfront to start, 50% on completion. for larger projects, we can split into milestones.
        </p>
      </details>
    </div>
  </section>

  <!-- Contact CTA -->
  <section id="contact" class="container mx-auto px-4 py-20 max-w-4xl">
    <div class="text-center py-16 rounded-2xl bg-opacity-5 animate-on-scroll" style="background-color: currentColor;">
      <h2 class="heading-handwritten text-4xl md:text-6xl mb-6">
        ready to start?
      </h2>
      <p class="text-lg opacity-80 mb-8 max-w-2xl mx-auto">
        let's chat about your project. no obligation, no pressure. just a friendly conversation about what you're building.
      </p>
      <div class="flex flex-wrap justify-center gap-4 mb-8">
        <a href="mailto:your@email.com" class="btn-primary text-lg px-8 py-4">
          send me an email
        </a>
        <a href="https://twitter.com/yourusername" target="_blank" rel="noopener noreferrer" class="btn-secondary text-lg px-8 py-4">
          dm on twitter
        </a>
      </div>
      <p class="text-sm opacity-50">
        or just say hi. chocolate ice cream and chicken biryani are acceptable forms of payment 🍦
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  details summary::-webkit-details-marker {
    display: none;
  }

  details[open] summary {
    margin-bottom: 1rem;
  }
</style>