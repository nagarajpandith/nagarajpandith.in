---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AuthButton from '../../components/AuthButton.astro';
import { supabase } from '../../utils/supabase';

export async function getStaticPaths() {
  const blogs = await getCollection('blog');
  return blogs.map(blog => ({
    params: { slug: blog.slug },
    props: { blog },
  }));
}

const { blog } = Astro.props;
const { Content, headings } = await blog.render();

// Calculate reading time
function calculateReadingTime(content: string): number {
  const wordsPerMinute = 200;
  const words = content.trim().split(/\s+/).length;
  return Math.ceil(words / wordsPerMinute);
}

const readingTime = calculateReadingTime(blog.body);

// Increment view count and get views
let views = 0;
try {
  const { data, error } = await supabase.rpc('increment_blog_view', { blog_slug: blog.slug });
  if (error) {
    // If function doesn't exist, try upsert
    const { data: viewData } = await supabase
      .from('blog_views')
      .select('views')
      .eq('slug', blog.slug)
      .single();
    
    if (viewData) {
      await supabase
        .from('blog_views')
        .update({ views: viewData.views + 1 })
        .eq('slug', blog.slug);
      views = viewData.views + 1;
    } else {
      await supabase
        .from('blog_views')
        .insert({ slug: blog.slug, views: 1 });
      views = 1;
    }
  } else {
    // Get updated view count
    const { data: viewData } = await supabase
      .from('blog_views')
      .select('views')
      .eq('slug', blog.slug)
      .single();
    views = viewData?.views || 0;
  }
} catch (err) {
  console.error('View count error:', err);
  views = 0;
}

// Get next blog if specified
let nextBlog = null;
if (blog.data.nextSlug) {
  const allBlogs = await getCollection('blog');
  nextBlog = allBlogs.find(b => b.slug === blog.data.nextSlug);
}

const tags = blog.data.tags.split(',').map(t => t.trim());
const shareUrl = `https://nagarajpandith.in/blog/${blog.slug}`;
const shareText = encodeURIComponent(blog.data.title);

// Fetch approved comments for this blog
const { data: comments } = await supabase
  .from('blog_comments')
  .select('*')
  .eq('blog_slug', blog.slug)
  .eq('is_approved', true)
  .order('created_at', { ascending: true });

const blogComments = comments || [];

// Format date
function formatDate(dateString: string): string {
  const date = new Date(dateString);
  const now = new Date();
  const diffInSeconds = Math.floor((now.getTime() - date.getTime()) / 1000);
  
  if (diffInSeconds < 60) return 'just now';
  if (diffInSeconds < 3600) return `${Math.floor(diffInSeconds / 60)} min ago`;
  if (diffInSeconds < 86400) return `${Math.floor(diffInSeconds / 3600)} hr ago`;
  if (diffInSeconds < 604800) return `${Math.floor(diffInSeconds / 86400)} days ago`;
  
  return date.toLocaleDateString('en-US', { 
    month: 'short', 
    day: 'numeric', 
    year: date.getFullYear() !== now.getFullYear() ? 'numeric' : undefined 
  });
}
---

<BaseLayout title={`${blog.data.title} - nagaraj pandith`} description={blog.data.desc}>
  <!-- Breadcrumb -->
  <div class="container mx-auto px-4 pt-6 max-w-4xl">
    <a href={blog.data.isPersonal ? '/blog/personal' : '/blog'} class="link text-sm opacity-60 hover:opacity-100 inline-flex items-center gap-2">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
      </svg>
      back to {blog.data.isPersonal ? 'personal' : 'blog'}
    </a>
  </div>

  <!-- Article -->
  <article class="container mx-auto px-4 py-8 max-w-4xl">
    <!-- Header -->
    <header class="mb-16 animate-on-scroll">
      <!-- Title -->
      <h1 class="text-4xl md:text-6xl font-bold mb-6 leading-tight tracking-tight">
        {blog.data.title}
      </h1>

      <!-- Meta -->
      <div class="flex flex-wrap items-center gap-3 text-sm opacity-60 mb-8">
        <time datetime={blog.data.publishedDate}>{blog.data.publishedDate}</time>
        <span>•</span>
        <span>{readingTime} min read</span>
        <span>•</span>
        <span>{views} views</span>
      </div>

      <!-- Cover Image -->
      <div class="relative overflow-hidden rounded-2xl aspect-video mb-8 bg-subtle">
        <img 
          src={blog.data.coverImage} 
          alt={blog.data.title}
          class="w-full h-full object-cover"
        />
      </div>

      <!-- Description -->
      <p class="text-xl md:text-2xl opacity-80 leading-relaxed mb-8 font-light">
        {blog.data.desc}
      </p>

      <!-- Tags & Share -->
      <div class="flex flex-wrap items-center justify-between gap-6 py-6 border-y border-opacity-10" style="border-color: currentColor;">
        <!-- Tags -->
        <div class="flex flex-wrap gap-2">
          {tags.map(tag => (
            <span class="text-xs bg-subtle px-3 py-1.5 rounded-full opacity-70">
              {tag}
            </span>
          ))}
        </div>

        <!-- Share -->
        <div class="flex gap-2">
          <a 
            href={`https://twitter.com/intent/tweet?text=${shareText}&url=${shareUrl}`}
            target="_blank"
            rel="noopener noreferrer"
            class="p-2.5 rounded-lg bg-subtle hover:opacity-70 transition-all"
            aria-label="Share on Twitter"
            title="Share on Twitter"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"></path>
            </svg>
          </a>
          <a 
            href={`https://www.linkedin.com/sharing/share-offsite/?url=${shareUrl}`}
            target="_blank"
            rel="noopener noreferrer"
            class="p-2.5 rounded-lg bg-subtle hover:opacity-70 transition-all"
            aria-label="Share on LinkedIn"
            title="Share on LinkedIn"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"></path>
            </svg>
          </a>
          <button 
            id="copy-link-btn"
            class="p-2.5 rounded-lg bg-subtle hover:opacity-70 transition-all"
            aria-label="Copy link"
            title="Copy link"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
            </svg>
          </button>
        </div>
      </div>
    </header>

    <!-- Content Grid -->
    <div class="grid grid-cols-1 xl:grid-cols-[1fr_250px] gap-12">
      <!-- Main Content -->
      <div class="prose-custom max-w-none">
        <Content />
      </div>

      <!-- Sidebar TOC (Desktop) -->
      {headings.length > 0 && (
        <aside class="hidden xl:block">
          <nav id="toc" class="bg-subtle rounded-xl p-6 sticky top-24">
            <h3 class="text-sm font-medium mb-4 opacity-60 uppercase tracking-wider">on this page</h3>
            <ul class="space-y-2.5 text-sm">
              {headings.map(heading => (
                <li style={`padding-left: ${(heading.depth - 2) * 12}px`}>
                  <a 
                    href={`#${heading.slug}`}
                    class="toc-link block opacity-60 hover:opacity-100 transition-opacity"
                    data-heading={heading.slug}
                  >
                    {heading.text}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </aside>
      )}
    </div>

    <!-- Next Blog CTA -->
    {nextBlog && (
      <div class="mt-16 pt-12 border-t border-opacity-10" style="border-color: currentColor;">
        <p class="text-sm opacity-60 mb-4">next up</p>
        <a href={`/blog/${nextBlog.slug}`} class="block group">
          <h3 class="text-2xl font-medium mb-2 group-hover:opacity-70 transition-opacity">
            {nextBlog.data.title}
          </h3>
          <p class="opacity-70">{nextBlog.data.desc}</p>
        </a>
      </div>
    )}

    <!-- Comments Section -->
    <section id="comments-section" class="mt-20 pt-12 border-t border-opacity-10" style="border-color: currentColor;">
      <h2 class="text-2xl font-medium mb-8">
        comments ({blogComments.length})
      </h2>

      <!-- Auth / Form -->
      <div class="mb-12">
        <div id="sign-in-prompt" class="hidden bg-subtle rounded-xl p-8 text-center">
          <p class="opacity-70 mb-4">sign in to leave a comment</p>
          <AuthButton />
        </div>

        <form id="comment-form" class="hidden bg-subtle rounded-xl p-6">
          <div class="space-y-4">
            <div class="flex items-center gap-3">
              <div id="user-avatar" class="w-10 h-10 rounded-full bg-subtle"></div>
              <div>
                <p id="user-name" class="font-medium text-sm"></p>
              </div>
            </div>

            <textarea
              id="comment-input"
              name="comment"
              required
              maxlength="1000"
              rows="4"
              placeholder="share your thoughts..."
              class="w-full px-4 py-3 rounded-lg bg-subtle border focus:outline-none focus:ring-2 focus:ring-opacity-50 transition-all resize-none"
              style="border-color: rgba(0, 0, 0, 0.1);"
            ></textarea>
            
            <div class="flex justify-between items-center">
              <p class="text-xs opacity-50">
                <span id="char-count">0</span>/1000
              </p>
              <button type="submit" class="btn-primary">
                post comment
              </button>
            </div>
          </div>
        </form>
      </div>

      <!-- Comments List -->
      <div class="space-y-6" id="comments-list">
        {blogComments.length === 0 ? (
          <p class="text-center opacity-50 py-12">no comments yet. be the first!</p>
        ) : (
          blogComments.map((comment) => (
            <article 
              class="comment-card bg-subtle rounded-xl p-6"
              data-user-id={comment.user_id}
            >
              <div class="flex items-start gap-4 mb-4">
                <div class="comment-avatar w-10 h-10 rounded-full bg-subtle flex items-center justify-center font-medium">
                  ?
                </div>
                <div class="flex-1">
                  <p class="comment-name font-medium text-sm">loading...</p>
                  <p class="text-xs opacity-50">{formatDate(comment.created_at)}</p>
                </div>
              </div>
              <p class="opacity-80 leading-relaxed whitespace-pre-wrap">
                {comment.content}
              </p>
            </article>
          ))
        )}
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  /* Prose Styling */
  .prose-custom {
    font-size: 1.125rem;
    line-height: 1.8;
  }

  .prose-custom :global(h2) {
    font-size: 2rem;
    font-weight: 700;
    margin-top: 3rem;
    margin-bottom: 1.5rem;
    line-height: 1.3;
  }

  .prose-custom :global(h3) {
    font-size: 1.5rem;
    font-weight: 600;
    margin-top: 2.5rem;
    margin-bottom: 1.25rem;
    line-height: 1.4;
  }

  .prose-custom :global(h4) {
    font-size: 1.25rem;
    font-weight: 600;
    margin-top: 2rem;
    margin-bottom: 1rem;
  }

  .prose-custom :global(p) {
    margin-bottom: 1.5rem;
  }

  .prose-custom :global(ul),
  .prose-custom :global(ol) {
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
  }

  .prose-custom :global(li) {
    margin-bottom: 0.5rem;
  }

  .prose-custom :global(blockquote) {
    border-left: 3px solid rgba(212, 197, 185, 0.3);
    padding-left: 1.5rem;
    margin: 2rem 0;
    opacity: 0.8;
    font-style: italic;
  }

  .prose-custom :global(code) {
    background-color: rgba(212, 197, 185, 0.1);
    padding: 0.2rem 0.4rem;
    border-radius: 0.25rem;
    font-size: 0.9em;
    font-family: 'Courier New', monospace;
  }

  .prose-custom :global(pre) {
    background-color: rgba(212, 197, 185, 0.05);
    padding: 1.5rem;
    border-radius: 0.75rem;
    overflow-x: auto;
    margin: 2rem 0;
  }

  .prose-custom :global(pre code) {
    background: none;
    padding: 0;
  }

  .prose-custom :global(a) {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: rgba(212, 197, 185, 0.3);
    text-underline-offset: 0.2em;
    transition: all 0.2s;
  }

  .prose-custom :global(a:hover) {
    text-decoration-color: currentColor;
    opacity: 0.7;
  }

  .prose-custom :global(img) {
    border-radius: 0.75rem;
    margin: 2rem 0;
  }

  .prose-custom :global(hr) {
    border: none;
    border-top: 1px solid;
    opacity: 0.1;
    margin: 3rem 0;
  }

  /* TOC Active State */
  .toc-link.active {
    opacity: 1;
    font-weight: 500;
  }

  /* Light mode adjustments */
  body.light .prose-custom :global(blockquote) {
    border-left-color: rgba(62, 39, 35, 0.3);
  }

  body.light .prose-custom :global(code) {
    background-color: rgba(62, 39, 35, 0.1);
  }

  body.light .prose-custom :global(pre) {
    background-color: rgba(62, 39, 35, 0.05);
  }

  body.light .prose-custom :global(a) {
    text-decoration-color: rgba(62, 39, 35, 0.3);
  }
</style>

<script>
  // Copy link functionality
  const copyBtn = document.getElementById('copy-link-btn');
  if (copyBtn) {
    copyBtn.addEventListener('click', () => {
      navigator.clipboard.writeText(window.location.href);
      const originalText = copyBtn.innerHTML;
      copyBtn.innerHTML = `
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
        </svg>
      `;
      setTimeout(() => {
        copyBtn.innerHTML = originalText;
      }, 2000);
    });
  }

  // TOC scroll spy
  if (window.innerWidth >= 1280) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        const id = entry.target.getAttribute('id');
        const tocLink = document.querySelector(`[data-heading="${id}"]`);
        
        if (entry.isIntersecting) {
          document.querySelectorAll('.toc-link').forEach(link => link.classList.remove('active'));
          tocLink?.classList.add('active');
        }
      });
    }, {
      rootMargin: '-100px 0px -66%',
    });

    document.querySelectorAll('.prose-custom h2[id], .prose-custom h3[id]').forEach(heading => {
      observer.observe(heading);
    });
  }

  // Comments: Auth check and form handling
  import { supabase } from '../../utils/supabase';

  async function checkAuth() {
    const { data: { session } } = await supabase.auth.getSession();
    
    if (session) {
      document.getElementById('sign-in-prompt')?.classList.add('hidden');
      document.getElementById('comment-form')?.classList.remove('hidden');
      
      const userName = document.getElementById('user-name');
      const userAvatar = document.getElementById('user-avatar');
      
      if (userName) userName.textContent = session.user.user_metadata.name || session.user.email;
      if (userAvatar) {
        if (session.user.user_metadata.avatar_url) {
          userAvatar.style.backgroundImage = `url(${session.user.user_metadata.avatar_url})`;
          userAvatar.style.backgroundSize = 'cover';
          userAvatar.style.backgroundPosition = 'center';
        } else {
          userAvatar.textContent = (session.user.user_metadata.name || session.user.email)[0].toUpperCase();
        }
      }
    } else {
      document.getElementById('sign-in-prompt')?.classList.remove('hidden');
      document.getElementById('comment-form')?.classList.add('hidden');
    }
  }

  checkAuth();

  // Character counter
  const commentInput = document.getElementById('comment-input') as HTMLTextAreaElement;
  const charCount = document.getElementById('char-count');
  
  if (commentInput && charCount) {
    commentInput.addEventListener('input', () => {
      charCount.textContent = commentInput.value.length.toString();
    });
  }

  // Form submission
  const commentForm = document.getElementById('comment-form');
  if (commentForm) {
    commentForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const { data: { session } } = await supabase.auth.getSession();
      if (!session) return;

      const content = (commentInput as HTMLTextAreaElement).value.trim();
      if (!content) return;

      const blogSlug = window.location.pathname.split('/').pop();

      const { error } = await supabase
        .from('blog_comments')
        .insert({
          blog_slug: blogSlug,
          user_id: session.user.id,
          content: content,
          is_approved: false
        });

      if (!error) {
        (commentInput as HTMLTextAreaElement).value = '';
        if (charCount) charCount.textContent = '0';
        alert('comment submitted! it will appear after approval.');
      } else {
        alert('failed to submit comment. please try again.');
      }
    });
  }

  // Load comment user info
  async function loadCommentUsers() {
    const commentCards = document.querySelectorAll('.comment-card');
    
    for (const card of commentCards) {
      const userId = card.getAttribute('data-user-id');
      if (!userId) continue;

      const { data, error } = await supabase.auth.admin.getUserById(userId);
      
      if (data?.user) {
        const nameEl = card.querySelector('.comment-name');
        const avatarEl = card.querySelector('.comment-avatar');
        
        if (nameEl) {
          nameEl.textContent = data.user.user_metadata.name || data.user.email || 'anonymous';
        }
        
        if (avatarEl) {
          if (data.user.user_metadata.avatar_url) {
            (avatarEl as HTMLElement).style.backgroundImage = `url(${data.user.user_metadata.avatar_url})`;
            (avatarEl as HTMLElement).style.backgroundSize = 'cover';
            (avatarEl as HTMLElement).style.backgroundPosition = 'center';
            avatarEl.textContent = '';
          } else {
            const name = data.user.user_metadata.name || data.user.email || '?';
            avatarEl.textContent = name[0].toUpperCase();
          }
        }
      }
    }
  }

  loadCommentUsers();
</script>
