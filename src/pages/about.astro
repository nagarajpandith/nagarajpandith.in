---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';

const workExperience = [
  {
    company: 'Wipfli India LLP',
    roles: [
      { title: 'Engineer II', period: 'Oct 2024 - Present', duration: 'ongoing' },
      { title: 'Engineer I', period: 'Jun 2024 - Oct 2024', duration: '5 months' },
      { title: 'Engineer I - Trainee', period: 'Mar 2024 - May 2024', duration: '3 months' }
    ],
    description: 'wipfli is a top 20 consulting firm in US. i\'m working with microsoft tech stack, specializing in javascript. built pcf controls with react, azure logic apps, c# .net plugins, power platform apps, dataverse customizations, and d365 implementations. also exploring solution design and architecture.',
    current: true
  },
  {
    company: 'Forent Inc.',
    roles: [
      { title: 'Software Engineer Intern', period: 'Nov 2022 - Jan 2023', duration: '3 months' }
    ],
    description: 'migrated excamp project from html/bootstrap to next.js with typescript & sass. focused on performance optimization and user experience. followed agile development using jira.',
    current: false
  }
];

const primaryTech = [
  { name: 'React', icon: '⚛️' },
  { name: 'Next.js', icon: '▲' },
  { name: 'TypeScript', icon: '📘' },
  { name: 'Django', icon: '🐍' },
  { name: 'Tailwind CSS', icon: '🎨' },
  { name: 'PostgreSQL', icon: '🐘' },
  { name: 'Git', icon: '🔀' },
  { name: 'C# .NET', icon: '💜' }
];

const achievements = [
  {
    title: 'Winner - Hackoverflow 1.0',
    description: '3-day national-level hackathon at pillai hoc, mumbai. this was my first ever offline hackathon and we built a multilingual video conferencing app using livekit & nextjs',
    year: '18-03-2023',
    link:'https://www.linkedin.com/feed/update/urn:li:activity:7043941054076637184/'
  },
  {
    title: 'Track Winner - Hackverse 4.0 (AI Track)',
    description: '24hr national-level hackathon at nitk',
    year: '16-04-2023',
    link:'https://www.linkedin.com/feed/update/urn:li:activity:7060835169556955136/'
  },
  {
    title: 'Special Prize - NivHack',
    description: 'most innovative approach at niveus solutions, mangalore',
    year: '27-08-2023',
    link:'https://www.linkedin.com/feed/update/urn:li:activity:7102829803791163392/'
  },
  {
    title: 'Winner - Web Ally',
    description: '6hr website design contest at sjec mangalore',
    year: '23-03-2023',
    link:'https://www.linkedin.com/feed/update/urn:li:activity:7049752134799536128/'
  },
  {
    title: 'Winner of \'Webbed\' and Runner-up in \'Web Piracy\'',
    description: 'web contests & challenges during College fest Incridea-2022',
    year: '04-02-2022',
    link:'https://www.linkedin.com/feed/update/urn:li:activity:7049752134799536128/'
  }
];

const communityWork = [
  {
    role: 'Judge',
    events: ['HackXpo S03', 'Hackfest 2025'],
    description: 'evaluated projects, provided feedback, scored the innovations, collaborated with other judges, asked valuable industry questions and selected winners'
  },
  {
    role: 'Mentor & Judge',
    events: ['Innovex 2025'],
    description: 'guided teams on day 1, asked the right questions, guided them to a better route and judged final presentations on day2 collaborating with other industry judges'
  },
  {
    role: 'Workshop Conductor',
    events: ['Git & GitHub Workshop (65+ students)', 'Open-source Contributions Workshop (70+ students)'],
    description: 'empowered students with version control and open source contribution and collaboration skills'
  },
  {
    role: 'President - Coding Club',
    events: ['hackfest-2025', 'workshops', 'mini hackathons', 'dsa sprints'],
    description: 'during my 2-3 years at this club, i led the team and organized various events and workshops for students. i started mini hackathons in the club to introduce freshers to building, started a discord server for the club, revamped the club website, maintained it as an open source project. my most favorite part here was conducting the first 3-day national level hackathon at my college. i found a bunch of passionate folks and each of them fave their 100 in this, the team was solid, so was the hackathon, 0 complaints, 100 participant satisfaction. i learnt a lot about leadership, teamwork, finance, event management, ground work and how to put together a successful event from scratch.'
  },
  {
    role: 'Skill Lab Trainer',
    events: ['Web Development & Git Training for Freshers'],
    description: 'trained incoming students in web fundamentals & version control system'
  }
];

const quirks = [
  { emoji: '🍦', text: 'i love chocolate ice cream and eat a whole tub in one sitting sometimes' },
  { emoji: '🍛', text: 'i cook chicken biryani really well' },
  { emoji: '😺', text: 'i obsess over cats and cat videos' },
  { emoji: '🎬', text: 'i watch a lot of crime thrillers, murder mysteries' },
  { emoji: '🏠', text: 'infj-t with weak social battery' },
  { emoji: '📚', text: 'obsessive documenter (i write everything down - my daily tasks, my thoughts, everything)' },
  { emoji: '🍳', text: 'i learnt to cook in 2025 and i\'m proud of it' },
  { emoji: '💗', text: 'i\'m a sucker for pink & lavender colors' }
];
---

<BaseLayout title="about - nagaraj pandith" description="full-stack developer obsessed with clean code, documentation, and making things work elegantly">
  <!-- Hero -->
  <section class="container mx-auto px-4 py-20 max-w-4xl animate-on-scroll">
    <h1 class="heading-handwritten text-5xl md:text-7xl mb-8">about me</h1>
    <Image src="/headshot.jpg" alt="about" width="300" height="300" class="rounded-lg mb-6" />
    <div class="text-lg md:text-xl opacity-90 leading-relaxed space-y-6">
      <p>
        hey there! i'm nagaraj pandith, but you might know me as <span class="opacity-60">hashclan</span> on the internet. i'm a full-stack developer from india. I build things for the web. Sometimes they're useful, sometimes they're fun, hopefully they're both. My toolkit includes typescript, next.js and whatever else gets the job done without overengineering it..
      </p>
      <p>
        by day, i'm building things at wipfli india. by night, i'm either debugging something that definitely worked yesterday, getting lost in crime thrillers, or get lost in thoughts like 'are we living in a simulation?'.
      </p>
      <p>
my approach: user-centric design, heavy documentation, and debugging until it's perfect.
      </p>
      <p>
      when im not coding, i'm looping through my “Liked Songs” playlist, scrolling through cat videos ig
      apart from tech, you can chat w me about cooking, fragnances, food, movies, shows, life, even philosophy sometimes
      if you get close to me, i'll tell you the best biryanis or the best chocolate icecreams in town to try
      </p>
      <p>my story: I fell in love with technology & computers (probably when i was 10 or 11 when i got my hands on office computer at my mum's workplace haha) and that passion never left my mind, it just felt very interesting and also explains why i ended becoming a homebody haha! but i do like going out and travel with my friends <3 </p>
      <p>i was kind of tech savvy growing up whenever i got hands on any device. straight from trying our custom ROMs on a phone which was slower than a calculator, or trying to obssess over cybersecurity and install kali linux on a hella slow laptop. i have more to share but all those experiences were fun and i think most of you might relate with this growing up</p>
      <p>in my uni days, i stopped focusing on curriculum and focused on learning nice tech i was interesetd in, mostly full stack. i later made some nice dev friends who shared a mutual interest and we started participating in hackathons, coding contests, building software for uni, working on freelance projects. in the last year i got into wipfli as a software engineer and i have come all the way till here and i'm grateful for that journey</p>
    </div>
  </section>

  <!-- Work Experience Timeline -->
  <section class="container mx-auto px-4 py-16 max-w-4xl animate-on-scroll">
    <h2 class="heading-handwritten text-4xl md:text-5xl mb-12">the journey</h2>
    
    <div class="space-y-12">
      {workExperience.map((job) => (
        <article class="relative pl-8 border-l-2" style="border-color: rgba(255, 255, 255, 0.1);">
          {job.current && (
            <div class="absolute -left-2 top-0 w-3 h-3 rounded-full bg-current animate-pulse"></div>
          )}
          <div class="mb-4">
            <h3 class="text-2xl font-medium mb-2">{job.company}</h3>
            <div class="space-y-1 mb-3">
              {job.roles.map((role) => (
                <div class="flex flex-col sm:flex-row sm:items-center sm:gap-3 text-sm opacity-70">
                  <span class="font-medium">{role.title}</span>
                  <span class="hidden sm:inline opacity-50">•</span>
                  <span>{role.period}</span>
                  <span class="hidden sm:inline opacity-50">•</span>
                  <span class="opacity-50">{role.duration}</span>
                </div>
              ))}
            </div>
            <p class="opacity-80 leading-relaxed">{job.description}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- Tech Stack -->
  <section class="container mx-auto px-4 py-16 max-w-4xl animate-on-scroll">
    <h2 class="heading-handwritten text-4xl md:text-5xl mb-12">the craft</h2>
    
    <p class="text-lg opacity-80 mb-8">
      i primarily work with modern javascript frameworks. here's what's in my toolkit:
    </p>

    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-8">
      {primaryTech.map((tech) => (
        <div class="bg-subtle bg-subtle-hover rounded-lg p-4 text-center transition-all">
          <div class="text-3xl mb-2">{tech.icon}</div>
          <div class="text-sm font-medium">{tech.name}</div>
        </div>
      ))}
    </div>

    <p class="text-sm opacity-60">
      currently learning: <span class="font-medium">htmx</span> and <span class="font-medium">golang</span>
    </p>

    <p class="text-sm opacity-60">
    Tech stack isn't my concern, I'm flexible with whatever the project needs, though I prefer modern frameworks and tools. I'm always open for new opportunities to learn and grow.
    </p>

    <div class="mt-6">
      <a href="/resume.pdf" target="_blank" class="link text-sm">
        see full tech stack in resume →
      </a>
    </div>
  </section>

  <!-- Achievements -->
  <section class="container mx-auto px-4 py-16 max-w-4xl animate-on-scroll">
    <h2 class="heading-handwritten text-4xl md:text-5xl mb-12">the wins</h2>
    
    <div class="grid sm:grid-cols-2 gap-6">
      {achievements.map((achievement) => (
        <article class="bg-subtle bg-subtle-hover rounded-lg p-6 transition-all">
          <div class="flex items-start justify-between mb-3">
            <h3 class="font-medium text-lg flex-1">{achievement.title}</h3>
            <span class="text-sm opacity-50 shrink-0 ml-4">{achievement.year}</span>
          </div>
          <p class="text-sm opacity-70">{achievement.description}</p>
          <a href={achievement.link} target="_blank" class="link text-sm">
            view post →
          </a>
        </article>
      ))}
    </div>
  </section>

  <!-- Community Involvement -->
  <section class="container mx-auto px-4 py-16 max-w-4xl animate-on-scroll">
    <div class="mb-12">
      <h2 class="heading-handwritten text-4xl md:text-5xl mb-2">community involvement</h2>
      <p class="text-lg opacity-60">giving back</p>
    </div>
    
    <div class="space-y-6">
      {communityWork.map((work) => (
        <article class="border-b pb-6 last:border-b-0" style="border-color: rgba(255, 255, 255, 0.1);">
          <div class="flex flex-col sm:flex-row sm:items-start gap-4 mb-3">
            <h3 class="font-medium text-lg shrink-0">{work.role}</h3>
            <div class="flex flex-wrap gap-2">
              {work.events.map((event) => (
                <span class="text-xs bg-subtle px-3 py-1 rounded">
                  {event}
                </span>
              ))}
            </div>
          </div>
          <p class="text-sm opacity-70">{work.description}</p>
        </article>
      ))}
    </div>
  </section>

  <!-- Quirks (Hidden Easter Egg Section) -->
  <section class="container mx-auto px-4 py-16 max-w-4xl animate-on-scroll">
    <details class="group">
      <summary class="cursor-pointer list-none">
        <div class="flex items-center justify-between py-4 hover:opacity-70 transition-opacity">
          <h2 class="heading-handwritten text-4xl md:text-5xl">the quirks</h2>
          <span class="text-2xl transform group-open:rotate-180 transition-transform">↓</span>
        </div>
      </summary>
      
      <div class="pt-8 pb-4">
        <p class="text-lg opacity-80 mb-8">
          some things you should know before hiring me (or bribing me):
        </p>
        <div class="grid sm:grid-cols-2 gap-4">
          {quirks.map((quirk) => (
            <div class="flex items-start gap-3 bg-subtle rounded-lg p-4">
              <span class="text-2xl shrink-0">{quirk.emoji}</span>
              <p class="text-sm opacity-80 pt-1">{quirk.text}</p>
            </div>
          ))}
        </div>
      </div>
    </details>
  </section>

  <!-- CTA -->
  <section class="container mx-auto px-4 py-20 max-w-4xl animate-on-scroll">
    <div class="text-center py-16 rounded-2xl bg-subtle">
      <h2 class="heading-handwritten text-3xl md:text-5xl mb-6">
        want to work together?
      </h2>
      <p class="text-lg opacity-70 mb-8">
        i'm always open to interesting projects and collaborations
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/freelance" class="btn-primary">
          hire me
        </a>
        <a href="/work" class="btn-secondary">
          see my work
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  body.light article {
    border-color: rgba(62, 39, 35, 0.1) !important;
  }
  
  body.light .border-l-2 {
    border-color: rgba(62, 39, 35, 0.1) !important;
  }

  /* Collapsible quirks section */
  details summary::-webkit-details-marker {
    display: none;
  }
</style>