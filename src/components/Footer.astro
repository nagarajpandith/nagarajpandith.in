          </svg>
          astro
        </a>
      </p>
    </div>
  </div>
</footer>

<style>
  body.light footer {
    border-color: rgba(62, 39, 35, 0.1) !important;
  }
  
  body.light footer .border-t {
    border-color: rgba(62, 39, 35, 0.1) !important;
  }
</style>