---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const allNotes = await getCollection('notes');

// Separate by type
const shortNotes = allNotes.filter(n => n.data.type === 'short').sort((a, b) => 
  a.data.title.localeCompare(b.data.title)
);

const longNotes = allNotes.filter(n => n.data.type === 'long').sort((a, b) => 
  new Date(b.data.updatedAt).getTime() - new Date(a.data.updatedAt).getTime()
);
---

<BaseLayout title="notes - nagaraj pandith" description="learning notes, flashcards, and quick references">
  <!-- Hero -->
  <section class="container mx-auto px-4 pt-48 pb-32 max-w-5xl animate-on-scroll">
    <div class="space-y-6">
      <h2 class="text-xs uppercase tracking-[0.2em] opacity-40 font-semibold">garden</h2>
      <h1 class="font-serif text-6xl md:text-8xl opacity-80 italic">the notes.</h1>
      <p class="text-xl opacity-60 max-w-2xl font-light leading-relaxed italic">
        a digital garden of quick flashcards and detailed deep dives from my learning adventures.
      </p>
    </div>
  </section>

  <!-- Stats -->
  <section class="container mx-auto px-4 pb-32 max-w-5xl animate-on-scroll border-t border-white/5 pt-12">
    <div class="grid grid-cols-2 gap-12 max-w-md">
      <div class="space-y-1">
        <div class="text-4xl font-light opacity-90">{shortNotes.length}</div>
        <div class="text-[10px] uppercase tracking-widest opacity-30 font-medium">flashcards</div>
      </div>
      <div class="space-y-1">
        <div class="text-4xl font-light opacity-90">{longNotes.length}</div>
        <div class="text-[10px] uppercase tracking-widest opacity-30 font-medium">deep dives</div>
      </div>
    </div>
  </section>

  <!-- Deep Dives -->
  <section class="container mx-auto px-4 py-32 max-w-5xl animate-on-scroll border-t border-white/5">
    <div class="flex flex-col md:flex-row gap-16 mb-24">
      <div class="md:w-1/4">
        <h2 class="text-xs uppercase tracking-[0.2em] opacity-40 font-semibold mb-6">learning</h2>
        <h3 class="font-serif text-4xl md:text-5xl opacity-80">deep dives</h3>
      </div>
    </div>
    
    <div class="grid md:grid-cols-2 gap-x-20 gap-y-12">
      {longNotes.map((note) => (
        <a 
          href={`/notes/${note.slug}`}
          class="group block py-8 border-b border-white/5 last:border-0 md:last:border-b"
        >
          <div class="flex items-center justify-between">
            <div>
              <span class="text-[10px] uppercase tracking-widest opacity-30 font-medium mb-3 block">
                updated {note.data.updatedAt.split('-').reverse().join('.')}
              </span>
              <h3 class="text-2xl font-light opacity-90 group-hover:opacity-60 transition-opacity">
                {note.data.title}
              </h3>
            </div>
            <svg class="w-5 h-5 opacity-0 group-hover:opacity-20 group-hover:translate-x-1 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
            </svg>
          </div>
        </a>
      ))}
    </div>

    {longNotes.length === 0 && (
      <p class="text-center opacity-30 font-light italic py-12">no deep dives yet.</p>
    )}
  </section>

  <!-- Flashcards -->
  <section class="container mx-auto px-4 py-32 max-w-5xl animate-on-scroll border-t border-white/5">
    <div class="flex flex-col md:flex-row gap-16 mb-24">
      <div class="md:w-1/4">
        <h2 class="text-xs uppercase tracking-[0.2em] opacity-40 font-semibold mb-6">quick bits</h2>
        <h3 class="font-serif text-4xl md:text-5xl opacity-80">flashcards</h3>
      </div>
    </div>
    
    <div class="grid sm:grid-cols-2 md:grid-cols-4 gap-x-12 gap-y-12">
      {shortNotes.map((note) => (
        <a 
          href={`/notes/${note.slug}`}
          class="group block p-8 bg-subtle hover:bg-transparent border border-transparent hover:border-white/10 transition-all duration-500"
        >
          <h3 class="text-lg font-light opacity-90 group-hover:opacity-60 transition-opacity text-center">
            {note.data.title}
          </h3>
        </a>
      ))}
    </div>

    {shortNotes.length === 0 && (
      <p class="text-center opacity-30 font-light italic py-12">no flashcards yet.</p>
    )}
  </section>

  <!-- CTA -->
  <section class="container mx-auto px-4 py-48 max-w-5xl animate-on-scroll border-t border-white/5">
    <div class="grid md:grid-cols-2 gap-20 items-center">
      <div>
        <h2 class="text-xs uppercase tracking-[0.2em] opacity-40 font-semibold mb-8">contribute</h2>
        <h3 class="font-serif text-5xl md:text-6xl opacity-80 leading-tight italic">
          spotted an <br /> error?
        </h3>
      </div>
      <div class="space-y-12">
        <p class="text-xl opacity-50 font-light leading-relaxed italic">
          these notes are living documents, evolving as i learn. if you see something wrong, help me fix it.
        </p>
        <div>
          <a href="mailto:nagaraj.pandith2002@gmail.com" class="link text-2xl border-b-2 border-current pb-1">
            let me know
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>