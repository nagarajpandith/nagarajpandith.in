---
import ThemeToggle from './ThemeToggle.astro';
---

<header class="fixed top-0 left-0 right-0 z-[120] transition-all duration-300 pointer-events-none">
  <!-- Top Bar: Always above menu -->
  <div class="pointer-events-auto backdrop-blur-md border-b bg-[var(--color-bg-primary)]/80 border-[var(--color-border)] relative z-[130]">
    <nav class="container flex items-center justify-between h-16 md:h-20">
      <!-- Logo / Name -->
      <a href="/" class="text-xl md:text-2xl font-serif tracking-tight hover:opacity-70 transition-opacity">
        np.
      </a>
      
      <!-- Desktop Navigation -->
      <div class="hidden md:flex items-center gap-8 text-sm font-medium">
        <a href="/work" class="link">work</a>
        <a href="/blog" class="link">writing</a>
        <a href="/notes" class="link">notes</a>
        <a href="/about" class="link">about</a>
        <a href="/recommendations" class="link">recs</a>
        
        <div class="w-px h-4 bg-[var(--color-border)] mx-2"></div>
         
        <div class="flex items-center gap-6">
          <a href="/resume.pdf" target="_blank" class="text-[var(--color-accent)] hover:opacity-80 transition-opacity">
            resume
          </a>
          <ThemeToggle />
        </div>
      </div>
      
      <!-- Mobile Controls -->
      <div class="flex items-center gap-4 md:hidden">
        <ThemeToggle />
        <button 
          id="mobile-menu-button"
          class="focus:outline-none p-2 -mr-2 text-[var(--color-text-primary)]"
          aria-label="Toggle menu"
        >
          <svg id="menu-icon-open" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
          <svg id="menu-icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
    </nav>
  </div>
  
  <!-- Mobile Navigation - Full Page Editorial -->
  <div 
    id="mobile-menu" 
    class="fixed inset-0 z-[110] pointer-events-none bg-[var(--color-bg-primary)] opacity-0 translate-x-full transition-all duration-300 md:hidden flex flex-col justify-center"
  >
    <div class="container h-full flex flex-col justify-center py-20">
      <div class="space-y-6">
        <a href="/work" class="mobile-nav-link stagger-link block text-5xl font-serif italic">work</a>
        <a href="/blog" class="mobile-nav-link stagger-link block text-5xl font-serif italic">writing</a>
        <a href="/notes" class="mobile-nav-link stagger-link block text-5xl font-serif italic">notes</a>
        <a href="/about" class="mobile-nav-link stagger-link block text-5xl font-serif italic">about</a>
        <a href="/recommendations" class="mobile-nav-link stagger-link block text-5xl font-serif italic">recs</a>
      </div>
      
      <div class="mt-16 pt-8 border-t border-[var(--color-border)] flex items-center justify-between stagger-link">
        <a href="/resume.pdf" target="_blank" class="text-xl font-medium text-[var(--color-accent)]">resume</a>
        <div class="flex gap-6 text-[var(--color-text-muted)]">
          <a href="https://github.com/nagarajpandith" target="_blank" class="text-xs uppercase tracking-widest">gh</a>
          <a href="https://linkedin.com/in/nagaraj-pandith" target="_blank" class="text-xs uppercase tracking-widest">li</a>
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  import { animate, stagger } from 'motion';

  function setupHeader() {
    const button = document.getElementById('mobile-menu-button');
    const menu = document.getElementById('mobile-menu');
    const openIcon = document.getElementById('menu-icon-open');
    const closeIcon = document.getElementById('menu-icon-close');
    const navLinks = document.querySelectorAll('.mobile-nav-link');
    
    let isOpen = false;

    function setMenuState(state: boolean) {
      isOpen = state;
      const menu = document.getElementById('mobile-menu');
      
      if (isOpen) {
        // Open Sequence
        menu?.classList.remove('opacity-0', 'pointer-events-none', 'translate-x-full');
        menu?.classList.add('pointer-events-auto');
        openIcon?.classList.add('hidden');
        closeIcon?.classList.remove('hidden');
        document.body.style.overflow = 'hidden';

        // Stagger Animation
        animate(
          '.stagger-link', 
          { opacity: 1, y: 0 }, 
          { delay: stagger(0.1), duration: 0.6, ease: [0.16, 1, 0.3, 1] }
        );

      } else {
        // Close Sequence
        menu?.classList.add('opacity-0', 'pointer-events-none', 'translate-x-full');
        menu?.classList.remove('pointer-events-auto');
        openIcon?.classList.remove('hidden');
        closeIcon?.classList.add('hidden');
        document.body.style.overflow = '';

        // Reset Stagger Links (Instant)
        animate('.stagger-link', { opacity: 0, y: 20 }, { duration: 0 });
      }
    }

    button?.addEventListener('click', (e) => {
      e.stopPropagation();
      setMenuState(!isOpen);
    });
    
    navLinks.forEach(link => {
      link.addEventListener('click', () => setMenuState(false));
    });
  }

  setupHeader();
  document.addEventListener('astro:after-swap', setupHeader);
</script>

<style>
  .mobile-nav-link {
    transition: transform 0.3s ease, opacity 0.3s ease;
  }
  .mobile-nav-link:hover {
    transform: translateX(10px);
    opacity: 0.7;
  }
</style>