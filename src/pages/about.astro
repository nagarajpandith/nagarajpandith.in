const quirks = [
  { text: 'i love chocolate ice cream and eat a whole tub in one sitting sometimes' },
  { text: 'i cook chicken biryani really well' },
  { text: 'i obsess over cats and cat videos' },
  { text: 'i watch a lot of crime thrillers, murder mysteries' },
  { text: 'infj-t with weak social battery' },
  { text: 'obsessive documenter (i write everything down - my daily tasks, my thoughts, everything)' },
  { text: 'i learnt to cook in 2025 and i\'m proud of it' },
  { text: 'i\'m a sucker for pink & lavender colors' }
];

const talks = [
  {
    title: 'Inside the Mind of ChatGPT',
    link: 'https://www.canva.com/design/DAGko2trUnA/5CX2O2jVxzkQaIxowH-dIw/view',
