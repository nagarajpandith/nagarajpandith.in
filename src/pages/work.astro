const designs = [
  '204036235',
  '204035799',
  '204035405',
  '204035277',
  '204035119',
  '204035511',
];

// Fetch shots from Supabase storage
let horizontalShots: string[] = [];
let verticalShots: string[] = [];

try {
  const { data: horizontalFiles } = await supabase.storage
    .from('shots')
    .list('horizontal', { limit: 100 });
  
  const { data: verticalFiles } = await supabase.storage
    .from('shots')
    .list('vertical', { limit: 100 });

  if (horizontalFiles) {
    horizontalShots = horizontalFiles
      .filter(file => !file.name.startsWith('.'))
      .map(file => 
        supabase.storage.from('shots').getPublicUrl(`horizontal/${file.name}`).data.publicUrl
      );
  }

  if (verticalFiles) {
    verticalShots = verticalFiles
      .filter(file => !file.name.startsWith('.'))
      .map(file => 
        supabase.storage.from('shots').getPublicUrl(`vertical/${file.name}`).data.publicUrl
      );
  }
} catch (error) {
  console.error('Error fetching shots:', error);
}

const allShots = [...horizontalShots, ...verticalShots];
---

<BaseLayout title="work - nagaraj pandith" description="projects, designs, and photography by nagaraj pandith">
  <!-- Hero -->
  <section class="container mx-auto px-4 py-20 max-w-6xl animate-on-scroll">
    <h1 class="heading-handwritten text-5xl md:text-7xl mb-6">my work</h1>
    <p class="text-xl opacity-80 max-w-2xl">
      a collection of projects i've built, designs i've crafted, and moments i've captured
    </p>
  </section>

  <!-- Sticky Filter Bar -->
  <div id="filter-bar" class="sticky top-16 z-40 backdrop-blur-md border-b transition-all" style="background-color: rgba(250, 248, 243, 0.8); border-color: rgba(62, 39, 35, 0.1);">
    <div class="container mx-auto px-4 py-4 max-w-6xl">
      <div class="flex flex-wrap items-center justify-between gap-4">
        <!-- Filter Chips -->
        <div class="flex flex-wrap gap-3">
          <button data-filter="projects" class="filter-chip active">
            projects ({projects.length})
          </button>
          <button data-filter="designs" class="filter-chip">
            designs ({designs.length})
          </button>
          <button data-filter="shots" class="filter-chip">
            shots ({allShots.length})
          </button>
        </div>

        <!-- Shuffle Button -->
        <button id="shuffle-btn" class="text-sm opacity-60 hover:opacity-100 transition-opacity flex items-center gap-2">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
          </svg>
          shuffle
        </button>
      </div>
    </div>
  </div>

  <!-- Projects Section -->
  <section id="projects-section" class="container mx-auto px-4 py-16 max-w-6xl section-content">
    <div class="grid md:grid-cols-2 gap-8">
      {projects.map((project, index) => (
