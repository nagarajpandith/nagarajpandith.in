---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
}

const { 
  title, 
  description = "full-stack developer who gets unreasonably excited about clean code and user delight. bribery accepted in chocolate ice cream or biryani." 
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content={description}>
  
  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  
  <!-- RSS Feed -->
  <link rel="alternate" type="application/rss+xml" title="nagaraj pandith - blog" href="/rss.xml" />
  
  <!-- Open Graph / Social Media -->
  <meta property="og:type" content="website">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  
  <title>{title}</title>

  <script>
    import Lenis from 'lenis'
    import { animate, inView } from 'motion'

    // Initialize Lenis for smooth scrolling
    const lenis = new Lenis({
      lerp: 0.1, // Smoothness (0-1)
      wheelMultiplier: 1.2, // Scroll speed
      smoothWheel: true,
    })

    function raf(time: number) {
      lenis.raf(time)
      requestAnimationFrame(raf)
    }

    requestAnimationFrame(raf)

    // Text Reveal Animation
    const reveal = () => {
      inView('.reveal-text:not(.is-visible)', (element) => {
        element.classList.add('is-visible');
        animate(
          element,
          { 
            opacity: [0, 1],
            y: [20, 0],
            filter: ['blur(8px)', 'blur(0px)']
          },
          { duration: 0.8, ease: [0.17, 0.55, 0.55, 1] }
        );
      });
    };

    reveal();

    // Re-run reveal check on Lenis scroll to ensure inView keeps tracking
    lenis.on('scroll', reveal);

    // Initial check for elements already in view
    setTimeout(() => {
      document.querySelectorAll('.reveal-text:not(.is-visible)').forEach(el => {
        const rect = el.getBoundingClientRect();
        if (rect.top < window.innerHeight) {
          el.dispatchEvent(new Event('mouseenter')); // Sometimes helps trigger observers
          // Manual reveal if still hidden after a bit
          setTimeout(() => {
            if (!el.classList.contains('is-visible')) {
              el.classList.add('is-visible');
              (el as HTMLElement).style.opacity = '1';
              (el as HTMLElement).style.transform = 'none';
              (el as HTMLElement).style.filter = 'none';
            }
          }, 500);
        }
      });
    }, 100);

    // Theme initialization
    const theme = (() => {
      if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
        return localStorage.getItem('theme');
      }
      return 'dark';
    })();
    
    if (theme === 'light') {
      document.body.classList.add('light');
    } else {
      document.body.classList.remove('light');
    }
  </script>
</head>
<body>
  <Header />
  
  <!-- Content Grid Background -->
  <div class="fixed inset-0 pointer-events-none z-0 flex justify-center">
    <div class="w-full h-full max-w-[var(--spacing-container)] px-2">
      <!-- Border-x at px-2 provides ample breathing room outside the px-6 content padding -->
      <div class="h-full w-full grid grid-cols-1 md:grid-cols-4 border-x border-dashed border-[var(--color-grid)]">
        <div class="hidden md:block border-r border-dashed border-[var(--color-grid)] h-full"></div>
        <div class="hidden md:block border-r border-dashed border-[var(--color-grid)] h-full"></div>
        <div class="hidden md:block border-r border-dashed border-[var(--color-grid)] h-full"></div>
        <div class="hidden md:block h-full"></div>
      </div>
    </div>
  </div>

  <main class="min-h-screen relative z-10">
    <slot />
  </main>
  
  <Footer />
  

  <style is:global>
    /* Animation Utilities */
    .reveal-text {
      opacity: 0;
      transform: translateY(20px);
      filter: blur(8px);
      will-change: opacity, transform, filter;
    }

    .stagger-link {
      opacity: 0;
      transform: translateY(20px);
    }

    /* Lenis Smooth Scroll */
    html.lenis, html.lenis body {
      height: auto;
    }

    .lenis.lenis-smooth {
      scroll-behavior: auto !important;
    }

    .lenis.lenis-smooth [data-lenis-prevent] {
      overscroll-behavior: contain;
    }

    .lenis.lenis-stopped {
      overflow: hidden;
    }

    .lenis.lenis-scrolling iframe {
      pointer-events: none;
    }
  </style>
</body>
</html>