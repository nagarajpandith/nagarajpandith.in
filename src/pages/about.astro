const travels = [
  { place: 'Wayanad, Kerala', date: 'Dec 2022' },
  { place: 'Pondicherry, Union Territory', date: 'Sept 2024' },
  { place: 'Dandeli, Karnataka', date: 'Mar 2025' },
  { place: 'Ooty-Coonoor, Tamil Nadu', date: 'Dec 2025' }
];

const recommendations = [
  {
    author: "Kohei Tsukazaki",
    role: "CEO & PM at Forent Inc.",
    date: "February 9, 2023",
    text: "I had the privilege of working with Nagaraj at forent as CEO and PM. In that time, I was consistently impressed by his technical skills and ability to deliver high-quality software solutions. Nagaraj has a strong understanding of React. He consistently demonstrates his ability to understand complex requirements and translate them into effective and efficient code. I highly recommend Nagaraj for any software engineering role. He has the skills, knowledge, and attitude to excel in any project and make a significant impact in any organization. His contributions to our team were invaluable, and I have no doubt he will continue to thrive in future endeavors."
  }
];
---

<BaseLayout title="about - nagaraj pandith" description="full-stack developer obsessed with clean code, documentation, and making things work elegantly">
  
  <div class="space-y-32 pb-32">
    
    <!-- Hero Section -->
    <section class="container mx-auto px-4 pt-32 max-w-5xl animate-on-scroll">
      <div class="grid md:grid-cols-2 gap-20 items-center">
        <div class="order-2 md:order-1 space-y-12">
          <div class="space-y-4">
            <h2 class="text-xs uppercase tracking-[0.2em] opacity-40 font-semibold">about me</h2>
            <h1 class="heading-handwritten text-5xl md:text-7xl opacity-80 italic">it's me, nagaraj.</h1>
          </div>
          
          <div class="text-xl opacity-90 leading-relaxed max-w-lg space-y-8 font-light">
            <p>
              i'm a full-stack developer from india who builds things for the web. 
              my everyday toolkit includes typescript, next.js, and whatever else gets the job done without unnecessary overengineering.
            </p>
            <p>
              currently building meaningful software at <span class="border-b border-current pb-0.5">wipfli</span> and obsessing over clean code.
            </p>
          </div>

          <div class="flex flex-wrap gap-8 items-center pt-4">
             <a href="/resume.pdf" target="_blank" class="link text-lg border-b border-current pb-1">
               download resume
             </a>
             <a href="#journey" class="link text-lg opacity-60 hover:opacity-100 transition-opacity">
               my journey
             </a>
          </div>
        </div>
        
        <div class="order-1 md:order-2 flex justify-center md:justify-end">
          <div class="relative w-64 h-64 md:w-96 md:h-96">
            <Image 
              src="/headshot2.jpg" 
              alt="Nagaraj Pandith" 
              width={500} 
              height={500} 
              class="w-full h-full object-cover grayscale opacity-80 hover:grayscale-0 hover:opacity-100 transition-all duration-700 ease-out bg-subtle" 
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Bio & Context -->
    <section class="container mx-auto px-4 max-w-5xl animate-on-scroll border-t border-white/5 pt-32">
      <div class="grid md:grid-cols-5 gap-16">
         <!-- Story -->
         <div class="md:col-span-3 space-y-8">
            <h2 class="text-xs uppercase tracking-[0.2em] opacity-40 font-semibold mb-6">my story</h2>
            <div class="text-xl font-light opacity-90 leading-relaxed space-y-8 italic">
              <p>
                i fell in love with computers around age 10, playing on an office computer at my mom's workplace. that curiosity evolved into flashing custom roms on slow phones and playing around with kali linux on even slower laptops.
              </p>
              <p>
                in university, i stopped optimizing for grades and started optimizing for learning. i found my tribe, built software for events, built amazing things at hackathons with sleepless nights, and never looked back. 
              </p>
            </div>
         </div>

         <!-- Life Outside Code -->
         <div class="md:col-span-2 space-y-8">
            <h2 class="text-xs uppercase tracking-[0.2em] opacity-40 font-semibold mb-6">life outside code</h2>
            <div class="space-y-6 text-base opacity-60 font-light leading-relaxed">
              <p>when i'm not coding, you'll probably find me:</p>
              <ul class="space-y-4">
                <li class="flex items-start gap-4"><span class="opacity-30">01.</span> looping my "liked songs" playlist</li>
                <li class="flex items-start gap-4"><span class="opacity-30">02.</span> doom-scrolling cat videos</li>
                <li class="flex items-start gap-4"><span class="opacity-30">03.</span> getting lost in crime thrillers</li>
                <li class="flex items-start gap-4"><span class="opacity-30">04.</span> watching endless youtube essays</li>
              </ul>
              <p class="pt-6">
                you can chat with me about cooking, fragrances, food, movies, shows, life, and - if you get close enough - philosophy. i'll also gladly tell you where to find the best biryanis or chocolate ice creams in town.
              </p>
            </div>
         </div>
      </div>
    </section>

  <!-- Work Experience Timeline -->
  <section id="journey" class="container mx-auto px-4 py-32 max-w-5xl animate-on-scroll border-t border-white/5">
    <div class="flex flex-col md:flex-row gap-16">
      <div class="md:w-1/4">
        <h2 class="text-xs uppercase tracking-[0.2em] opacity-40 font-semibold mb-6">the journey</h2>
        <h3 class="heading-handwritten text-4xl md:text-5xl opacity-80">experience</h3>
      </div>
      
      <div class="md:w-3/4 space-y-24">
          {workExperience.map((job) => (
          <article class="group">
            <div class="flex flex-col sm:flex-row sm:justify-between sm:items-baseline gap-4 mb-6">
              <h3 class="text-2xl font-light opacity-90 group-hover:opacity-60 transition-opacity">
                {job.company}
              </h3>
              {job.current && (
                <span class="text-[10px] uppercase tracking-widest opacity-30 border border-current/20 px-2 py-0.5 rounded-full">present</span>
              )}
            </div>
            
            <div class="space-y-4 mb-8">
              {job.roles.map((role) => (
                <div class="flex flex-col sm:flex-row sm:items-center sm:gap-4 text-sm font-light">
                  <span class="opacity-80">{role.title}</span>
                  <span class="hidden sm:inline w-1 h-1 rounded-full bg-current opacity-20"></span>
                  <span class="opacity-50">{role.period}</span>
                  <span class="hidden sm:inline w-1 h-1 rounded-full bg-current opacity-20"></span>
                  <span class="opacity-30">{role.duration}</span>
                </div>
              ))}
            </div>
            
            <p class="text-base opacity-50 leading-relaxed font-light max-w-2xl">
              {job.description}
            </p>
          </article>
          ))}
      </div>
    </div>
  </section>

  <!-- Tech Stack -->
  <section class="container mx-auto px-4 py-32 max-w-5xl animate-on-scroll border-t border-white/5">
    <div class="grid md:grid-cols-5 gap-16">
      <div class="md:col-span-1">
        <h2 class="text-xs uppercase tracking-[0.2em] opacity-40 font-semibold mb-6">the craft</h2>
        <h3 class="heading-handwritten text-4xl md:text-5xl opacity-80">toolkit</h3>
      </div>
      
      <div class="md:col-span-4 space-y-16">
        <div class="flex flex-wrap gap-x-12 gap-y-6">
          {primaryTech.map((tech) => (
            <div class="group flex items-center gap-3">
              <span class="text-lg font-light opacity-40 group-hover:opacity-90 transition-opacity">{tech.name}</span>
            </div>
          ))}
        </div>

        <div class="grid md:grid-cols-2 gap-12 pt-8">
          <div class="space-y-4">
            <h4 class="text-xs uppercase tracking-widest opacity-30 font-medium">currently learning</h4>
            <p class="text-lg font-light opacity-60 italic">
              htmx, golang stack and exploring agentic ai
            </p>
          </div>
          <div class="space-y-4">
            <h4 class="text-xs uppercase tracking-widest opacity-30 font-medium">philosophy</h4>
            <p class="text-sm font-light opacity-50 leading-relaxed">
              tech stack isn't my concern. i'm language agnostic and flexible with whatever the project needs, though i prefer modern frameworks and tools.
            </p>
          </div>
        </div>

        <div class="pt-8">
          <a href="/resume.pdf" target="_blank" class="link text-sm opacity-50 hover:opacity-100 transition-opacity border-b border-transparent hover:border-current pb-1">
            see full tech stack in resume →
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Achievements -->
  <section class="container mx-auto px-4 py-32 max-w-5xl animate-on-scroll border-t border-white/5">
    <div class="flex flex-col md:flex-row gap-16 mb-20">
      <div class="md:w-1/4">
        <h2 class="text-xs uppercase tracking-[0.2em] opacity-40 font-semibold mb-6">the wins</h2>
        <h3 class="heading-handwritten text-4xl md:text-5xl opacity-80">milestones</h3>
      </div>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-12">
      {achievements.map((achievement) => (
        <article class="group animate-on-scroll flex flex-col">
          <a href={achievement.link} target="_blank" rel="noopener noreferrer" class="block mb-6">
            <div class="relative overflow-hidden aspect-video bg-subtle">
              <Image 
                src={achievement.image} 
                alt={achievement.title}
                width={500}
                height={300}
                class="w-full h-full object-cover grayscale opacity-40 group-hover:grayscale-0 group-hover:opacity-100 group-hover:scale-105 transition-all duration-700 ease-out"
              />
            </div>
          </a>
          <div class="flex flex-col flex-1">
            <div class="flex items-center justify-between mb-2">
              <span class="text-[10px] uppercase tracking-widest opacity-30 font-medium">
                {achievement.year.split('-').reverse().join('.')}
              </span>
            </div>
            <h3 class="text-lg font-medium tracking-tight mb-3">
              {achievement.title}
            </h3>
            <p class="text-sm opacity-50 leading-relaxed font-light mb-4">
              {achievement.description}
            </p>
            <a href={achievement.link} target="_blank" rel="noopener noreferrer" class="link text-xs border-b border-current inline-block self-start opacity-0 group-hover:opacity-100 transition-opacity">
              view details
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- Community Involvement -->
  <section class="container mx-auto px-4 py-32 max-w-5xl animate-on-scroll border-t border-white/5">
    <div class="flex flex-col md:flex-row gap-16 mb-24">
      <div class="md:w-1/4">
        <h2 class="text-xs uppercase tracking-[0.2em] opacity-40 font-semibold mb-6">community</h2>
        <h3 class="heading-handwritten text-4xl md:text-5xl opacity-80">giving back</h3>
      </div>
    </div>

    <div class="space-y-32">
      {communityWork.map((work) => (
        <article class="group grid md:grid-cols-2 gap-16 items-center">
          <div class="aspect-[4/3] overflow-hidden bg-subtle order-2 md:order-1">
             <Image 
               src={work.image} 
               alt={work.role} 
               width={600}
               height={450}
               class="w-full h-full object-cover grayscale opacity-50 group-hover:grayscale-0 group-hover:opacity-100 transition-all duration-700 ease-out"
             />
          </div>
          <div class="space-y-8 order-1 md:order-2">
            <div class="flex flex-wrap gap-4">
              {work.events.map((event) => (
                <span class="text-[10px] uppercase tracking-widest opacity-30 font-medium">{event}</span>
              ))}
            </div>
            <h3 class="text-3xl font-light opacity-90">{work.role}</h3>
            <p class="text-lg opacity-50 leading-relaxed font-light italic">
              {work.description}
            </p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- Talks & Workshops -->
  <section class="container mx-auto px-4 py-32 max-w-5xl animate-on-scroll border-t border-white/5">
    <div class="flex flex-col md:flex-row gap-16 mb-24">
      <div class="md:w-1/4">
        <h2 class="text-xs uppercase tracking-[0.2em] opacity-40 font-semibold mb-6">talks</h2>
        <h3 class="heading-handwritten text-4xl md:text-5xl opacity-80">sharing</h3>
      </div>
    </div>

    <div class="grid md:grid-cols-2 gap-x-16 gap-y-24">
      {talks.map((talk) => (
        <article class="group">
          <a href={talk.link} target="_blank" rel="noopener noreferrer" class="block mb-8">
            <div class="relative overflow-hidden aspect-video bg-subtle">
               <Image 
                 src={talk.image} 
                 alt={talk.title}
                 width={600}
                 height={337}
                 class="w-full h-full object-cover grayscale opacity-40 group-hover:grayscale-0 group-hover:opacity-100 transition-all duration-700 ease-out"
               />
            </div>
          </a>
          <div class="space-y-4">
            <div class="flex items-center gap-4">
              <span class="text-[10px] uppercase tracking-[0.2em] opacity-30 font-medium">{talk.type}</span>
              <span class="w-1 h-1 rounded-full bg-current opacity-10"></span>
              <span class="text-[10px] uppercase tracking-[0.2em] opacity-30 font-medium">{talk.audience}</span>
            </div>
            <h3 class="text-2xl font-light opacity-90 group-hover:opacity-60 transition-opacity">
              {talk.title}
            </h3>
            <p class="text-base opacity-50 leading-relaxed font-light line-clamp-2 italic">
              {talk.description}
            </p>
            <a href={talk.link} target="_blank" rel="noopener noreferrer" class="link text-sm border-b border-current inline-block pt-4 opacity-0 group-hover:opacity-100 transition-opacity">
              view slides →
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- Recommendations -->
  <section class="container mx-auto px-4 py-32 max-w-5xl animate-on-scroll border-t border-white/5">
    <div class="flex flex-col md:flex-row gap-16 mb-24">
      <div class="md:w-1/4">
        <h2 class="text-xs uppercase tracking-[0.2em] opacity-40 font-semibold mb-6">kind words</h2>
        <h3 class="heading-handwritten text-4xl md:text-5xl opacity-80">recognition</h3>
      </div>
    </div>

    <div class="space-y-24">
      {recommendations.map((rec) => (
        <article class="max-w-3xl">
           <p class="text-2xl md:text-3xl leading-relaxed opacity-90 mb-12 font-light italic">
             "{rec.text}"
           </p>
           <div class="flex items-center gap-6">
             <div class="w-12 h-px bg-current opacity-20"></div>
             <div>
               <h4 class="text-lg font-medium opacity-90">{rec.author}</h4>
               <p class="text-sm opacity-40 uppercase tracking-widest">{rec.role}</p>
             </div>
           </div>
        </article>
      ))}
    </div>
    
    <div class="mt-24 pt-12 border-t border-white/5">
       <a 
        href="https://www.linkedin.com/in/nagaraj-pandith/" 
        target="_blank" 
        rel="noopener noreferrer"
        class="link text-sm opacity-50 hover:opacity-100 transition-opacity border-b border-transparent hover:border-current pb-1"
       >
         stalk me (and maybe recommend me) on linkedin →
       </a>
    </div>
  </section>

  <!-- Travel Log -->
  <section class="container mx-auto px-4 py-32 max-w-5xl animate-on-scroll border-t border-white/5">
    <div class="flex flex-col md:flex-row gap-16 mb-24">
      <div class="md:w-1/4">
        <h2 class="text-xs uppercase tracking-[0.2em] opacity-40 font-semibold mb-6">travel log</h2>
        <h3 class="heading-handwritten text-4xl md:text-5xl opacity-80">places</h3>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-12">
      {travels.map((trip) => (
