---
import BaseLayout from '../layouts/BaseLayout.astro';
import { supabase } from '../utils/supabase';

// Fetch data
const { data: movies } = await supabase
  .from('recommendations')
  .select('*')
  .order('year', { ascending: false });

const recommendations = movies || [];

// Extract unique genres for the filter list
const allGenres = [...new Set(recommendations.flatMap(m => m.genres || []))].sort();

const totalMovies = recommendations.length;
const avgRating = (recommendations.reduce((acc, m) => acc + (m.imdb_rating || 0), 0) / recommendations.length).toFixed(1);

// Pick a random initial backdrop
const initialBackdrop = recommendations.length > 0 
  ? recommendations[Math.floor(Math.random() * recommendations.length)].backdrop_url 
  : '';
---

<BaseLayout title="Cinema - Nagaraj Pandith" description="A collection of films and series that have left a mark.">
  
  <!-- Backdrops (Double Buffer) -->
  <div class="fixed inset-0 z-0 pointer-events-none select-none overflow-hidden">
    <!-- Active Backdrop -->
    <div id="bg-active" class="absolute inset-0 bg-cover bg-center bg-no-repeat transition-opacity duration-700 ease-in-out opacity-100" style={`background-image: url('${initialBackdrop}')`}></div>
    <!-- Next Backdrop (Preloader) -->
    <div id="bg-next" class="absolute inset-0 bg-cover bg-center bg-no-repeat transition-opacity duration-700 ease-in-out opacity-0"></div>
    
    <!-- Overlay -->
    <div id="backdrop-overlay" class="absolute inset-0 bg-[var(--color-bg-primary)] transition-colors duration-500"></div>
    
    <!-- Local Grid Lines -->
    <div class="absolute inset-0 w-full h-full max-w-[var(--spacing-container)] mx-auto px-2 z-[5] pointer-events-none">
       <div class="h-full w-full grid grid-cols-1 md:grid-cols-4 border-x border-dashed border-[var(--color-grid)]">
        <div class="hidden md:flex justify-end h-full"><div class="grid-line-v"></div></div>
        <div class="hidden md:flex justify-end h-full"><div class="grid-line-v"></div></div>
        <div class="hidden md:flex justify-end h-full"><div class="grid-line-v"></div></div>
        <div class="hidden md:block h-full"></div>
      </div>
    </div>
  </div>

  <!-- Content -->
  <section class="container relative z-10 pt-24 pb-12">
    
    <!-- Header -->
    <div class="max-w-4xl mb-24 min-h-[350px] flex flex-col justify-end" id="top-anchor">
      <span class="text-label block mb-6 reveal-text">Curated Watchlist</span>
      
      <div class="relative min-h-[1.1em] mb-8 overflow-hidden"> 
        <h1 class="text-6xl md:text-9xl font-serif leading-[0.85] split-text tracking-tighter m-0 p-0">
          Cinema
        </h1>
      </div>
      
      <div class="grid md:grid-cols-[2fr_1fr] gap-12 items-end">
        <div class="min-h-[6rem] relative"> 
          <p class="text-muted text-lg md:text-xl font-light leading-relaxed reveal-simple opacity-0" style="transition-delay: 0.1s;">
            A personal collection of movies and series that have moved, inspired, or simply entertained me. 
            Usually dark, often thoughtful, always worth your time.
          </p>
        </div>
        
        <div class="flex gap-12 reveal-simple opacity-0 border-t border-[var(--color-border)] pt-6 md:border-t-0 md:pt-0" style="transition-delay: 0.3s;">
          <div>
            <span class="block text-3xl font-serif">{totalMovies}</span>
            <span class="text-label text-[10px] tracking-widest mt-1 block opacity-50">Titles</span>
          </div>
          <div>
            <span class="block text-3xl font-serif">{avgRating}</span>
            <span class="text-label text-[10px] tracking-widest mt-1 block opacity-50">Avg Rating</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Filter Bar (Static) -->
    <div class="relative z-50 mb-12 reveal-simple opacity-0" style="transition-delay: 0.4s;">
      <div class="flex flex-col md:flex-row gap-4 justify-between items-stretch md:items-end">
         
         <!-- Custom Searchable Select -->
         <div class="relative w-full md:w-72 group" id="custom-select-container">
            <button id="genre-trigger" class="w-full flex justify-between items-center border border-[var(--color-border)] bg-[var(--color-bg-primary)] px-5 py-4 text-xs uppercase tracking-widest hover:border-[var(--color-text-muted)] transition-colors text-left group-hover:border-[var(--color-text-muted)] cursor-pointer">
              <span id="selected-genre-text">All Genres</span>
              <svg width="10" height="6" viewBox="0 0 10 6" fill="none" class="opacity-50 transition-transform duration-300 group-hover:rotate-180">
                <path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
            
            <!-- Dropdown -->
            <div id="genre-dropdown" class="absolute z-[60] top-full left-0 w-full mt-2 bg-[var(--color-bg-primary)] border border-[var(--color-border)] shadow-2xl opacity-0 invisible transform -translate-y-2 transition-all duration-200">
              <div class="p-2 border-b border-[var(--color-border)]">
                <input type="text" id="genre-search" placeholder="SEARCH GENRES..." class="w-full bg-[var(--color-bg-secondary)] px-3 py-2 text-xs uppercase tracking-wider focus:outline-none placeholder:opacity-40 text-[var(--color-text-primary)]" autocomplete="off" />
              </div>
              <ul id="genre-list" class="max-h-60 overflow-y-auto overscroll-contain py-2">
                <li class="genre-option px-4 py-2 hover:bg-[var(--color-bg-secondary)] cursor-pointer text-xs uppercase tracking-wider transition-colors text-[var(--color-text-primary)]" data-value="">All Genres</li>
                {allGenres.map(genre => (
                  <li class="genre-option px-4 py-2 hover:bg-[var(--color-bg-secondary)] cursor-pointer text-xs uppercase tracking-wider transition-colors text-[var(--color-text-primary)]" data-value={genre}>{genre}</li>
                ))}
              </ul>
            </div>
         </div>

         <!-- Random Pick Button -->
         <button id="random-pick" class="w-full md:w-auto border border-[var(--color-border)] px-8 py-4 text-xs uppercase tracking-widest hover:bg-[var(--color-text-primary)] hover:text-[var(--color-bg-primary)] transition-all duration-300 whitespace-nowrap bg-[var(--color-bg-primary)] cursor-pointer">
            Surprise Me
         </button>
      </div>
    </div>

    <!-- Grid -->
    <div id="movies-grid" class="relative z-10 grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-x-6 gap-y-16">
      {recommendations.map((movie) => (
        <article 
          class="movie-card group cursor-pointer"
          data-genres={JSON.stringify(movie.genres || [])}
          data-rating={movie.imdb_rating}
          data-id={movie.id}
          data-backdrop={movie.backdrop_url}
          id={`movie-${movie.id}`}
        >
          <div class="hidden movie-json" data-json={JSON.stringify(movie)}></div>

          <div class="relative aspect-[2/3] overflow-hidden mb-6 bg-[var(--color-bg-secondary)]">
            {movie.poster_url ? (
              <img 
                src={movie.poster_url} 
                alt={movie.title}
                class="w-full h-full object-cover transition-all duration-700 ease-out md:grayscale md:group-hover:grayscale-0"
                loading="lazy"
              />
            ) : (
              <div class="w-full h-full flex items-center justify-center p-4">
                <span class="text-label opacity-50">{movie.title}</span>
              </div>
            )}
            
            <!-- Minimal Overlay -->
            <div class="absolute inset-0 bg-black/20 opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"></div>
          </div>
          
          <div class="space-y-2">
            <h3 class="text-sm md:text-base font-medium leading-tight group-hover:text-[var(--color-accent)] transition-colors">{movie.title}</h3>
            <div class="flex items-center gap-3 text-[10px] text-[var(--color-text-muted)] tracking-widest uppercase">
              <span>{movie.year}</span>
              <span class="w-px h-2 bg-[var(--color-border)]"></span>
              <span>{movie.imdb_rating}/10</span>
            </div>
          </div>
        </article>
      ))}
    </div>

    <!-- No Results State -->
    <div id="no-results" class="hidden py-32 text-center relative z-10">
      <p class="font-serif text-3xl text-[var(--color-text-muted)] italic">No matches found.</p>
      <button id="reset-filters" class="mt-6 text-xs tracking-widest uppercase border-b border-[var(--color-accent)] pb-1 hover:text-[var(--color-accent)] transition-colors">Reset Filter</button>
    </div>

  </section>

  <!-- Back To Top -->
  <button id="back-to-top" class="fixed bottom-8 right-8 z-[90] p-4 rounded-full border border-[var(--color-border)] bg-[var(--color-bg-primary)] text-[var(--color-text-primary)] opacity-0 translate-y-4 transition-all duration-300 hover:scale-105 hover:border-[var(--color-text-muted)] disabled:pointer-events-none" aria-label="Back to top">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M12 19V5M5 12l7-7 7 7"/>
    </svg>
  </button>

  <!-- Detail Dialog -->
  <dialog id="movie-dialog" class="bg-transparent p-0 m-0 w-screen h-screen max-w-none max-h-none backdrop:bg-black/80 backdrop-blur-md outline-none border-none text-[var(--color-text-primary)] z-[100] fixed top-0 left-0">
    
    <div class="w-full h-full flex items-center justify-center md:p-12 cursor-pointer" id="dialog-wrapper">
      
      <div class="relative w-full h-full md:h-auto md:max-w-6xl md:max-h-[85vh] bg-[var(--color-bg-primary)] border border-[var(--color-border)] shadow-2xl flex flex-col md:flex-row overflow-hidden cursor-default transition-all duration-500 opacity-0 translate-y-4 rounded-none md:rounded-sm" id="dialog-card">
        
        <!-- Close Button -->
        <button id="close-dialog" class="absolute top-4 right-4 z-50 p-2 text-[var(--color-text-primary)] opacity-70 hover:opacity-100 transition-opacity bg-[var(--color-bg-primary)]/80 rounded-full md:hover:bg-[var(--color-bg-primary)] md:border md:border-transparent md:hover:border-[var(--color-border)] cursor-pointer">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>

        <!-- Image Side (Desktop Only) -->
        <div class="hidden md:block w-5/12 h-full bg-[var(--color-bg-secondary)] relative overflow-hidden group">
           <img id="modal-poster" src="" class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-105" alt="" />
           <div class="absolute inset-0 bg-gradient-to-t from-[var(--color-bg-primary)] via-transparent to-transparent opacity-50"></div>
        </div>

        <!-- Mobile Header Image -->
        <div class="md:hidden relative w-full h-[45vh] flex-shrink-0">
           <img id="modal-poster-mobile" src="" class="w-full h-full object-cover" alt="" />
           <div class="absolute inset-0 bg-gradient-to-t from-[var(--color-bg-primary)] via-transparent to-transparent"></div>
        </div>

        <!-- Content Side -->
        <div class="w-full md:w-7/12 flex flex-col h-full overflow-y-auto bg-[var(--color-bg-primary)] p-6 md:p-16 relative -mt-12 md:mt-0 z-10">
          
          <div class="flex-grow">
             <!-- Desktop Header -->
             <div class="hidden md:block">
               <div class="flex items-center gap-4 mb-6 text-xs tracking-widest uppercase text-[var(--color-text-muted)]">
                  <span id="modal-year"></span>
                  <span class="w-px h-3 bg-[var(--color-border)]"></span>
                  <span id="modal-type"></span>
                  <span class="w-px h-3 bg-[var(--color-border)]"></span>
                  <span id="modal-runtime"></span>
               </div>
               <h2 id="modal-title" class="text-6xl font-serif mb-8 leading-[0.9] tracking-tight text-[var(--color-text-primary)]"></h2>
             </div>

             <!-- Mobile Header Information -->
             <div class="md:hidden mb-6">
                <h2 id="modal-title-mobile" class="text-4xl font-serif leading-[0.9] tracking-tight text-[var(--color-text-primary)] mb-3"></h2>
                <div class="flex flex-wrap items-center gap-3 text-xs tracking-widest uppercase text-[var(--color-text-muted)]">
                   <span id="modal-year-mobile"></span>
                   <span class="w-px h-3 bg-[var(--color-border)]"></span>
                   <span id="modal-runtime-mobile"></span>
                   <span class="w-px h-3 bg-[var(--color-border)]"></span>
                   <span id="modal-rating-mobile" class="font-bold text-[var(--color-text-primary)]"></span>
                </div>
             </div>
             
             <div class="space-y-4">
               <div>
                  <h4 class="text-[10px] uppercase tracking-widest text-[var(--color-text-muted)] mb-3 md:mb-3">Genres</h4>
                  <div id="modal-genres" class="flex flex-wrap gap-2 text-[var(--color-text-primary)]"></div>
               </div>
             </div>
          </div>
  
          <!-- Actions -->
          <div class="pt-8 mt-8 border-t border-[var(--color-border)] flex flex-wrap gap-4 md:gap-8 items-center justify-between pb-safe">
              <div class="hidden md:block">
                 <span class="block text-[10px] uppercase tracking-widest text-[var(--color-text-muted)] mb-1">IMDb Rating</span>
                 <div class="flex items-baseline gap-1">
                   <span id="modal-rating" class="text-4xl font-serif text-[var(--color-text-primary)]"></span>
                   <span class="text-xl font-serif text-[var(--color-text-muted)]">/ 10</span>
                 </div>
              </div>

              <!-- High Contrast Button -->
              <!-- Using explicit styles to force visibility -->
              <a id="modal-imdb-link" href="#" target="_blank" class="w-full md:w-auto text-center px-8 py-4 text-xs uppercase tracking-widest font-bold transition-all cursor-pointer hover:opacity-80" style="background-color: var(--color-text-primary); color: var(--color-bg-primary);">
                View on IMDb
              </a>
          </div>
        </div>
      </div>
    </div>
  </dialog>

</BaseLayout>

<style>
  /* Fix Footer Visibility: Force footer to be higher z-index in global scope */
  :global(footer) {
    position: relative;
    z-index: 20;
  }

  /* Adjust Overlay Opacity by Theme */
  #backdrop-overlay {
    opacity: 0.85; 
  }
  
  :global(body.light) #backdrop-overlay {
    opacity: 0.65;
  }

  .reveal-simple {
    animation: fadeIn 1s ease-out forwards;
  }
  
  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  #genre-dropdown ::-webkit-scrollbar {
    width: 4px;
  }
  #genre-dropdown ::-webkit-scrollbar-track {
    background: var(--color-bg-secondary);
  }
  #genre-dropdown ::-webkit-scrollbar-thumb {
    background: var(--color-border);
    border-radius: 2px;
  }
  #genre-dropdown ::-webkit-scrollbar-thumb:hover {
    background: var(--color-text-muted);
  }

  .movie-card {
    contain: content;
  }

  .pb-safe {
    padding-bottom: env(safe-area-inset-bottom, 20px);
  }
</style>

<script>
  // --- DOM Elements ---
  const bgActive = document.getElementById('bg-active');
  const bgNext = document.getElementById('bg-next');
  
  const movieCards = document.querySelectorAll('.movie-card');
  const customSelectContainer = document.getElementById('custom-select-container');
  const genreTrigger = document.getElementById('genre-trigger');
  const genreDropdown = document.getElementById('genre-dropdown');
  const genreList = document.getElementById('genre-list');
  const genreSearch = document.getElementById('genre-search') as HTMLInputElement;
  const selectedGenreText = document.getElementById('selected-genre-text');
  const moviesGrid = document.getElementById('movies-grid');
  const noResults = document.getElementById('no-results');
  const resetBtn = document.getElementById('reset-filters');
  const randomPickBtn = document.getElementById('random-pick');
  const backToTopBtn = document.getElementById('back-to-top');
  
  // Dialog Elements
  const dialog = document.getElementById('movie-dialog') as HTMLDialogElement;
  const dialogWrapper = document.getElementById('dialog-wrapper');
  const dialogCard = document.getElementById('dialog-card');
  const closeDialogBtn = document.getElementById('close-dialog');
  const modalPoster = document.getElementById('modal-poster') as HTMLImageElement;
  const modalPosterMobile = document.getElementById('modal-poster-mobile') as HTMLImageElement;
  const modalTitle = document.getElementById('modal-title');
  const modalTitleMobile = document.getElementById('modal-title-mobile');
  const modalYear = document.getElementById('modal-year');
  const modalYearMobile = document.getElementById('modal-year-mobile');
  const modalType = document.getElementById('modal-type');
  const modalRuntime = document.getElementById('modal-runtime');
  const modalRuntimeMobile = document.getElementById('modal-runtime-mobile');
  const modalGenres = document.getElementById('modal-genres');
  const modalRating = document.getElementById('modal-rating');
  const modalRatingMobile = document.getElementById('modal-rating-mobile');
  const modalImdbLink = document.getElementById('modal-imdb-link') as HTMLAnchorElement;

  let activeGenre = '';
  let currentBackdropUrl = bgActive ? bgActive.style.backgroundImage.slice(5, -2) : '';

  // --- Core: Back to Top ---
  window.addEventListener('scroll', () => {
    if (window.scrollY > 500) {
      backToTopBtn?.classList.remove('opacity-0', 'translate-y-4');
      backToTopBtn?.removeAttribute('disabled');
    } else {
      backToTopBtn?.classList.add('opacity-0', 'translate-y-4');
      backToTopBtn?.setAttribute('disabled', 'true');
    }
  });

  backToTopBtn?.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });

  // --- Core: Smart Backdrop Transitions ---
  function updateBackdrop(url: string) {
    if (!url || !bgActive || !bgNext) return;
    if (currentBackdropUrl === url) return;

    bgNext.style.backgroundImage = `url('${url}')`;
    bgNext.style.opacity = '1';
    
    setTimeout(() => {
      bgActive.style.backgroundImage = `url('${url}')`;
      bgNext.style.opacity = '0'; 
      currentBackdropUrl = url;
    }, 700); 
  }

  movieCards.forEach(card => {
    card.addEventListener('mouseenter', () => {
      const backdropUrl = card.getAttribute('data-backdrop');
      if (backdropUrl) {
        updateBackdrop(backdropUrl);
      }
    });
  });

  // --- Core: Custom Select ---
  function toggleDropdown() {
    const isHidden = genreDropdown?.classList.contains('invisible');
    if (isHidden) {
      genreDropdown?.classList.remove('invisible', 'opacity-0', '-translate-y-2');
      genreDropdown?.classList.add('opacity-100', 'translate-y-0');
      genreSearch?.focus();
    } else {
      closeDropdown();
    }
  }

  function closeDropdown() {
    genreDropdown?.classList.add('invisible', 'opacity-0', '-translate-y-2');
    genreDropdown?.classList.remove('opacity-100', 'translate-y-0');
    setTimeout(() => {
      if (genreSearch) genreSearch.value = '';
      genreList?.querySelectorAll('li').forEach(li => li.style.display = 'block');
    }, 200);
  }

  genreTrigger?.addEventListener('click', (e) => {
    e.stopPropagation();
    toggleDropdown();
  });

  document.addEventListener('click', (e) => {
    if (!customSelectContainer?.contains(e.target as Node)) {
      closeDropdown();
    }
  });

  genreSearch?.addEventListener('input', (e) => {
    const term = (e.target as HTMLInputElement).value.toLowerCase();
    const items = genreList?.querySelectorAll('li');
    items?.forEach(item => {
      const text = item.textContent?.toLowerCase() || '';
      item.style.display = text.includes(term) ? 'block' : 'none';
    });
  });

  genreList?.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (target.tagName === 'LI') {
      const value = target.getAttribute('data-value') || '';
      activeGenre = value;
      if (selectedGenreText) selectedGenreText.textContent = value || 'All Genres';
      closeDropdown();
      applyFilters();
    }
  });

  function applyFilters() {
    let visibleCount = 0;
    movieCards.forEach(card => {
      const el = card as HTMLElement;
      const genres = JSON.parse(el.dataset.genres || '[]');
      const matches = !activeGenre || genres.includes(activeGenre);
      if (matches) {
        el.style.display = 'block';
        visibleCount++;
      } else {
        el.style.display = 'none';
      }
    });

    if (visibleCount === 0) {
      moviesGrid?.classList.add('hidden');
      noResults?.classList.remove('hidden');
    } else {
      moviesGrid?.classList.remove('hidden');
      noResults?.classList.add('hidden');
    }
  }

  resetBtn?.addEventListener('click', () => {
    activeGenre = '';
    if (selectedGenreText) selectedGenreText.textContent = 'All Genres';
    closeDropdown();
    applyFilters();
  });

  // --- Core: Random Pick & Modal ---
  randomPickBtn?.addEventListener('click', (e) => {
    e.stopPropagation(); 
    const visibleCards = Array.from(document.querySelectorAll('.movie-card')).filter(c => (c as HTMLElement).style.display !== 'none');
    
    if (visibleCards.length > 0) {
      const randomCard = visibleCards[Math.floor(Math.random() * visibleCards.length)];
      const dataDiv = randomCard.querySelector('.movie-json');
      if (dataDiv) {
        try {
           const data = JSON.parse(dataDiv.getAttribute('data-json') || '{}');
           openModal(data);
        } catch (err) {
           console.error('Error parsing JSON', err);
        }
      }
    }
  });

  function openModal(movie: any) {
    if (!dialog) return;

    // Desktop Fields
    if (modalPoster) modalPoster.src = movie.poster_url || '';
    if (modalTitle) modalTitle.textContent = movie.title || 'Untitled';
    if (modalYear) modalYear.textContent = movie.year || 'N/A';
    
    const type = movie.title_type === 'movie' ? 'Feature Film' : 'Series';
    if (modalType) modalType.textContent = type;

    const runtime = movie.runtime_mins 
      ? `${Math.floor(movie.runtime_mins / 60)}h ${movie.runtime_mins % 60}m`
      : '';
    if (modalRuntime) modalRuntime.textContent = runtime;

    if (modalRating) modalRating.textContent = movie.imdb_rating || '—';

    // Mobile Fields
    if (modalPosterMobile) modalPosterMobile.src = movie.poster_url || '';
    if (modalTitleMobile) modalTitleMobile.textContent = movie.title || 'Untitled';
    if (modalYearMobile) modalYearMobile.textContent = movie.year || 'N/A';
    if (modalRatingMobile) modalRatingMobile.textContent = movie.imdb_rating ? `${movie.imdb_rating}/10` : '—';
    if (modalRuntimeMobile) modalRuntimeMobile.textContent = runtime || '';

    if (modalGenres) {
      modalGenres.innerHTML = (movie.genres || []).map((g: string) => 
        `<span class="px-3 py-1 border border-[var(--color-border)] text-[10px] uppercase tracking-wider">${g}</span>`
      ).join('');
    }

    // Modal Link
    if (modalImdbLink) modalImdbLink.href = movie.imdb_url || '#';

    dialog.showModal();
    document.body.style.overflow = 'hidden';

    setTimeout(() => {
      dialogCard?.classList.remove('opacity-0', 'translate-y-4');
    }, 10);
  }

  moviesGrid?.addEventListener('click', (e) => {
    const card = (e.target as HTMLElement).closest('.movie-card');
    if (card) {
      const dataDiv = card.querySelector('.movie-json');
      if (dataDiv) {
        try {
          const raw = dataDiv.getAttribute('data-json') || '{}';
          const data = JSON.parse(raw);
          openModal(data);
        } catch(err) {
          console.error('Error parsing JSON', err);
        }
      }
    }
  });

  function closeDialog() {
    dialogCard?.classList.add('opacity-0', 'translate-y-4');
    setTimeout(() => {
      dialog?.close();
      document.body.style.overflow = '';
    }, 300);
  }

  closeDialogBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    closeDialog();
  });

  dialogWrapper?.addEventListener('click', (e) => {
     if (e.target === dialogWrapper) {
       closeDialog();
     }
  });
  
  dialogCard?.addEventListener('click', (e) => {
    e.stopPropagation();
  });
</script>