            <a href={project.link} target="_blank" rel="noopener noreferrer" class="block h-full w-full">
              <img 
                src={project.img} 
                alt={project.title}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out"
              />
