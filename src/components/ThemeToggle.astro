<button
  id="theme-toggle"
  class="p-2 rounded-lg hover:bg-opacity-10 transition-colors cursor-pointer"
  style="background-color: rgba(255, 255, 255, 0.1);"
  aria-label="Toggle theme"
>
  <svg id="sun-icon" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path>
  </svg>
  <svg id="moon-icon" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path>
  </svg>
</button>

<script>
  const button = document.getElementById('theme-toggle');
  const sunIcon = document.getElementById('sun-icon');
  const moonIcon = document.getElementById('moon-icon');
  
  // Initialize theme - default to light mode
  const currentTheme = localStorage.getItem('theme') || 'light';
  updateTheme(currentTheme);
  
  button?.addEventListener('click', (e) => {
    e.preventDefault();
    const newTheme = document.body.classList.contains('light') ? 'dark' : 'light';
    updateTheme(newTheme);
    localStorage.setItem('theme', newTheme);
  });
  
  // Also handle touch events for better mobile support
  button?.addEventListener('touchstart', (e) => {
    e.preventDefault();
    const newTheme = document.body.classList.contains('light') ? 'dark' : 'light';
    updateTheme(newTheme);
    localStorage.setItem('theme', newTheme);
  });
  
  function updateTheme(theme: string) {
    if (theme === 'light') {
      document.body.classList.add('light');
      sunIcon?.classList.remove('hidden');
      moonIcon?.classList.add('hidden');
    } else {
      document.body.classList.remove('light');
      sunIcon?.classList.add('hidden');
      moonIcon?.classList.remove('hidden');
    }
  }
</script>

<style>
  #theme-toggle {
    cursor: pointer;
  }
  
  body.light #theme-toggle {
    background-color: rgba(62, 39, 35, 0.1) !important;
  }
  
  body.light #theme-toggle:hover {
    background-color: rgba(62, 39, 35, 0.2) !important;
  }
</style>