const designs = [
  '204036235',
  '204035799',
  '204035405',
  '204035277',
  '204035119',
  '204035511',
];

// Fetch shots from Supabase storage
let horizontalShots: string[] = [];
let verticalShots: string[] = [];

try {
  const { data: horizontalFiles } = await supabase.storage
    .from('shots')
    .list('horizontal', { limit: 100 });
  
  const { data: verticalFiles } = await supabase.storage
    .from('shots')
    .list('vertical', { limit: 100 });

  if (horizontalFiles) {
    horizontalShots = horizontalFiles
      .filter(file => !file.name.startsWith('.'))
      .map(file => 
        supabase.storage.from('shots').getPublicUrl(`horizontal/${file.name}`).data.publicUrl
      );
  }

  if (verticalFiles) {
    verticalShots = verticalFiles
      .filter(file => !file.name.startsWith('.'))
      .map(file => 
        supabase.storage.from('shots').getPublicUrl(`vertical/${file.name}`).data.publicUrl
      );
  }
} catch (error) {
  console.error('Error fetching shots:', error);
}

const allShots = [...horizontalShots, ...verticalShots];
---

<BaseLayout title="work - nagaraj pandith" description="projects, designs, and photography by nagaraj pandith">
  <!-- Hero -->
  <section class="container mx-auto px-4 pt-32 max-w-5xl animate-on-scroll">
    <div class="space-y-6">
      <h2 class="text-xs uppercase tracking-[0.2em] opacity-40 font-semibold">portfolio</h2>
      <h1 class="font-serif text-5xl md:text-7xl opacity-80 italic">my work.</h1>
      <p class="text-xl opacity-60 max-w-2xl font-light leading-relaxed italic">
        a collection of projects i've built, designs i've crafted, and moments i've captured
      </p>
    </div>
  </section>

  <!-- Filter Bar -->
  <div id="filter-bar" class="sticky top-0 z-40 backdrop-blur-md transition-all border-b border-white/5 bg-transparent py-8">
    <div class="container mx-auto px-4 max-w-5xl">
      <div class="flex flex-wrap items-center justify-between gap-8">
        <!-- Filter Sliders -->
        <div class="flex items-center gap-12 overflow-x-auto no-scrollbar">
          <button data-filter="projects" class="filter-link active text-sm uppercase tracking-widest font-medium opacity-40 hover:opacity-100 transition-opacity whitespace-nowrap">
            projects <sup>{projects.length}</sup>
          </button>
          <button data-filter="designs" class="filter-link text-sm uppercase tracking-widest font-medium opacity-40 hover:opacity-100 transition-opacity whitespace-nowrap">
            designs <sup>{designs.length}</sup>
          </button>
          <button data-filter="shots" class="filter-link text-sm uppercase tracking-widest font-medium opacity-40 hover:opacity-100 transition-opacity whitespace-nowrap">
            shots <sup>{allShots.length}</sup>
          </button>
        </div>

        <!-- Shuffle Button -->
        <button id="shuffle-btn" class="text-[10px] uppercase tracking-[0.2em] opacity-30 hover:opacity-80 transition-opacity flex items-center gap-3">
          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
          </svg>
          randomize
        </button>
      </div>
    </div>
  </div>

  <!-- Projects Section -->
  <section id="projects-section" class="container mx-auto px-4 py-24 max-w-5xl section-content">
    <div class="grid md:grid-cols-2 gap-x-20 gap-y-32">
      {projects.map((project, index) => (
        <article class="group animate-on-scroll flex flex-col" data-index={index}>
          <!-- Project Image -->
          <a href={project.link} target="_blank" rel="noopener noreferrer" class="block mb-8">
            <div class="relative overflow-hidden aspect-video bg-subtle">
              <img 
                src={project.img} 
                alt={project.title}
                class="w-full h-full object-cover grayscale opacity-40 group-hover:grayscale-0 group-hover:opacity-100 group-hover:scale-105 transition-all duration-700 ease-out"
              />
            </div>
          </a>

          <!-- Project Details -->
          <div class="flex-1 flex flex-col">
            <div class="flex items-center justify-between mb-4">
              <h2 class="text-2xl font-light tracking-tight opacity-90">
                {project.title}
              </h2>
              <div class="flex gap-4 text-[10px] uppercase tracking-[0.2em] opacity-0 group-hover:opacity-40 transition-opacity duration-300">
                <a href={project.link} target="_blank" rel="noopener noreferrer" class="link border-b border-current">live</a>
                <a href={`https://github.com/${project.github}`} target="_blank" rel="noopener noreferrer" class="link border-b border-current">code</a>
              </div>
            </div>

            <p class="text-base opacity-50 leading-relaxed mb-8 font-light italic line-clamp-3">
              {project.description}
            </p>

            <!-- Tags -->
            <div class="flex flex-wrap gap-x-4 gap-y-2 mt-auto">
              {project.tags.map(tag => (
                <span class="text-[10px] uppercase tracking-widest opacity-20 font-medium whitespace-nowrap">
                  {tag}
                </span>
              ))}
            </div>
          </div>
        </article>
      ))}
    </div>

    <!-- Mini Projects -->
    <div class="mt-48 pt-32 border-t border-white/5">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-8 mb-20">
        <div>
           <h2 class="text-xs uppercase tracking-[0.2em] opacity-40 font-semibold mb-4">the archives</h2>
           <h3 class="font-serif text-4xl md:text-5xl opacity-80">mini projects</h3>
        </div>
        <a href="https://github.com/nagarajpandith" target="_blank" rel="noopener noreferrer" class="link text-sm opacity-50 hover:opacity-100 transition-opacity border-b border-transparent hover:border-current pb-1">
          all on github →
        </a>
      </div>

      <div class="grid md:grid-cols-3 gap-x-12 gap-y-24">
        {miniprojects.map((project, index) => (
          <article class="group animate-on-scroll" data-index={index}>
            <div class="flex items-start justify-between mb-4">
              <h3 class="text-xl font-light opacity-90 group-hover:opacity-60 transition-opacity">{project.title}</h3>
              <div class="flex gap-4 opacity-0 group-hover:opacity-30 transition-opacity">
                {project.link && (
                  <a href={project.link} target="_blank" rel="noopener noreferrer" class="link">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
                  </a>
                )}
              </div>
            </div>
            
            <p class="text-sm opacity-50 mb-8 leading-relaxed font-light italic">
              {project.description}
            </p>
            
            <div class="flex flex-wrap gap-x-4 gap-y-2">
              {project.tags.map(tag => (
                <span class="text-[10px] uppercase tracking-widest opacity-20 font-medium">
                  {tag}
                </span>
              ))}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Designs Section -->
  <section id="designs-section" class="container mx-auto px-4 py-24 max-w-5xl section-content hidden">
    <div class="grid lg:grid-cols-2 gap-20">
      {designs.map((designId, index) => (
        <div class="animate-on-scroll grayscale opacity-40 hover:grayscale-0 hover:opacity-100 transition-all duration-700 ease-out" data-index={index}>
          <iframe 
            src={`https://www.behance.net/embed/project/${designId}?ilo0=1`}
            height="316" 
            allowfullscreen 
            loading="lazy"
            allow="clipboard-write" 
            referrerpolicy="strict-origin-when-cross-origin"
            class="w-full aspect-video rounded-sm"
          ></iframe>
        </div>
      ))}
    </div>
  </section>

  <!-- Shots Section -->
  <section id="shots-section" class="container mx-auto px-4 py-24 max-w-5xl section-content hidden">
    <div id="shots-grid" class="columns-1 sm:columns-2 lg:columns-3 gap-8 space-y-8">
      {allShots.map((shot, index) => (
        <div class="break-inside-avoid animate-on-scroll group shot-item" data-index={index}>
          <img 
            src={shot} 
            alt="photography shot"
            class="w-full transition-all duration-700 ease-out cursor-zoom-in hover:scale-[1.02]"
            loading="lazy"
            data-shot-url={shot}
          />
        </div>
      ))}
    </div>
  </section>

  <!-- Lightbox Gallery Component -->
  <Lightbox id="work-lightbox" />
</BaseLayout>

<style>
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  .filter-link {
    position: relative;
    padding: 0.5rem 0;
  }

  .filter-link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0;
    height: 1px;
    background-color: currentColor;
    transition: width 0.3s ease;
  }

  .filter-link.active {
    opacity: 1 !important;
  }

  .filter-link.active::after {
    width: 100%;
  }

  sup {
    font-family: var(--font-serif);
    font-size: 0.6em;
    top: -0.8em;
    opacity: 0.4;
  }
</style>

<script>
  // Filter functionality
  const filterLinks = document.querySelectorAll('.filter-link');
  const sections = document.querySelectorAll('.section-content');
  const shuffleBtn = document.getElementById('shuffle-btn');
  
  let currentFilter = 'projects';

  filterLinks.forEach(link => {
    link.addEventListener('click', () => {
      const filter = link.getAttribute('data-filter');
      if (!filter) return;
      currentFilter = filter;
      
      // Update active state
      filterLinks.forEach(l => l.classList.remove('active'));
      link.classList.add('active');
      
      // Show/hide sections
      sections.forEach(section => {
        if (section.id === `${filter}-section`) {
          section.classList.remove('hidden');
          // Trigger scroll animations for new content
          const animateElements = section.querySelectorAll('.animate-on-scroll');
          animateElements.forEach(el => {
            if (el.getBoundingClientRect().top < window.innerHeight) {
              el.classList.add('is-visible');
            }
          });
        } else {
          section.classList.add('hidden');
        }
      });
    });
  });

  // Shuffle functionality
  shuffleBtn?.addEventListener('click', () => {
    const activeSection = document.getElementById(`${currentFilter}-section`);
    if (!activeSection) return;

    // Support both grid and columns layout
    const gridContainer = activeSection.querySelector('.grid') || activeSection.querySelector('[class*="columns-"]');
    if (!gridContainer) return;

    const items = Array.from(gridContainer.querySelectorAll('[data-index]'));
    
    // Shuffle array
    for (let i = items.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      const temp = items[i];
      items[i] = items[j];
      items[j] = temp;
    }

    // Re-append in shuffled order
    items.forEach(item => {
      gridContainer.appendChild(item);
    });

    // Visual feedback
    shuffleBtn.style.transform = 'rotate(180deg)';
    setTimeout(() => {
      shuffleBtn.style.transform = 'rotate(0deg)';
    }, 300);
  });

  // Lightbox Initialization
  // @ts-ignore
  if (typeof window.initLightbox === 'function') {
    // @ts-ignore
    window.initLightbox('.shot-item', '#shots-grid');
  }
</script>