---
const currentYear = new Date().getFullYear();
---

<footer class="mt-32 pb-12 text-sm">
  <div class="max-w-[var(--spacing-container)] mx-auto px-2">
    <div class="border-t border-[var(--color-border)] pt-12 md:pt-16 px-4">
      <div class="grid grid-cols-1 md:grid-cols-4 gap-12 md:gap-8">
        <!-- About Section -->
        <div class="md:col-span-2 space-y-6">
          <div>
            <h3 class="font-serif text-xl mb-4">nagaraj pandith.</h3>
            <p class="text-[var(--color-text-muted)] max-w-sm leading-relaxed">
              software engineer focused on building polished, performant, and delightful digital experiences.
            </p>
          </div>

          <!-- Guestbook CTA -->
          <div class="bg-[var(--color-bg-secondary)] rounded p-6 border border-[var(--color-border)] max-w-sm">
            <p class="font-serif font-medium mb-2 text-base">Guestbook</p>
            <p class="text-[var(--color-text-muted)] mb-4 leading-relaxed">
              Drop by and say hi! I'd love to hear from you.
            </p>
            <a href="/guestbook" class="inline-flex items-center gap-2 text-[var(--color-text-primary)] hover:opacity-70 transition-opacity border-b border-[var(--color-border)] pb-0.5">
              Sign Guestbook
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
            </a>
          </div>
        </div>
        
        <!-- Sitemap -->
        <div>
          <h4 class="text-label mb-6">Sitemap</h4>
          <ul class="space-y-3">
            <li><a href="/work" class="link">Work</a></li>
            <li><a href="/blog" class="link">Writing</a></li>
            <li><a href="/notes" class="link">Notes</a></li>
            <li><a href="/about" class="link">About</a></li>
            <li><a href="/recommendations" class="link">Recs</a></li>
            <li><a href="/tools" class="link">Tools</a></li>
            <li><a href="/guestbook" class="link">Guestbook</a></li>
          </ul>
        </div>
        
        <!-- Resources & Connect -->
        <div>
          <h4 class="text-label mb-6">Connect</h4>
          <ul class="space-y-3">
            <li><a href="https://github.com/nagarajpandith" target="_blank" class="link">GitHub</a></li>
            <li><a href="https://linkedin.com/in/nagaraj-pandith/" target="_blank" class="link">LinkedIn</a></li>
            <li><a href="mailto:nagaraj.pandith2002@gmail.com" class="link">Email</a></li>
            <li class="pt-4 flex flex-col gap-2">
              <a href="/rss.xml" class="text-[var(--color-accent)] hover:underline flex items-center gap-2">RSS Feed</a>
              <a href="/sitemap.xml" target="_blank" class="text-[var(--color-accent)] hover:underline">Sitemap (XML)</a>
            </li>
            <li><a href="/resume.pdf" class="text-[var(--color-accent)] hover:underline">Download Resume</a></li>
          </ul>
        </div>
      </div>
      
      <!-- Bottom Bar -->
      <div class="mt-20 pt-8 border-t border-[var(--color-border)] flex flex-col md:flex-row justify-between items-center gap-4 text-[var(--color-text-muted)] text-xs">
        <p>&copy; {currentYear} Nagaraj Pandith. All rights reserved.</p>
        <p class="flex items-center gap-1">
          Built with <a href="https://astro.build" class="underline hover:no-underline text-[var(--color-text-primary)]">Astro</a>
        </p>
      </div>
    </div>
  </div>
</footer>