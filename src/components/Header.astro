---
---

<header class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 pointer-events-none">
  <div class="pointer-events-auto backdrop-blur-md border-b" style="background-color: rgba(11, 20, 20, 0.85); border-color: var(--color-border);">
    <nav class="container flex items-center justify-between h-16 md:h-20">
      <!-- Logo / Name -->
      <a href="/" class="text-xl md:text-2xl font-serif tracking-tight hover:opacity-70 transition-opacity">
        np.
      </a>
      
      <!-- Desktop Navigation -->
      <div class="hidden md:flex items-center gap-8 text-sm font-medium">
        <a href="/work" class="link">work</a>
        <a href="/blog" class="link">writing</a>
        <a href="/notes" class="link">notes</a>
        <a href="/about" class="link">about</a>
        <a href="mailto:nagaraj.pandith2002@gmail.com" class="link">contact</a>
        
        <div class="w-px h-4 bg-[var(--color-border)] mx-2"></div>
        
        <a href="/resume.pdf" target="_blank" class="text-[var(--color-accent)] hover:opacity-80 transition-opacity">
          resume
        </a>
      </div>
      
      <!-- Mobile Menu Button -->
      <div class="flex items-center gap-4 md:hidden">
        <button 
          id="mobile-menu-button"
          class="focus:outline-none p-2 -mr-2 text-[var(--color-text-primary)]"
          aria-label="Toggle menu"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </div>
    </nav>
  </div>
  
  <!-- Mobile Navigation -->
  <div 
    id="mobile-menu" 
    class="hidden md:hidden pointer-events-auto border-b"
    style="background-color: var(--color-bg-primary); border-color: var(--color-border);"
  >
    <div class="container py-8 flex flex-col gap-6 text-lg">
      <a href="/work" class="link">work</a>
      <a href="/blog" class="link">writing</a>
      <a href="/notes" class="link">notes</a>
      <a href="/about" class="link">about</a>
      <a href="mailto:nagaraj.pandith2002@gmail.com" class="link">contact</a>
      <a href="/resume.pdf" target="_blank" class="text-[var(--color-accent)]">resume</a>
    </div>
  </div>
</header>

<script>
  const button = document.getElementById('mobile-menu-button');
  const menu = document.getElementById('mobile-menu');
  
  button?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
    // Change icon or animate if desired
  });
</script>