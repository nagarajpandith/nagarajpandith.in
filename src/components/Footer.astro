        </div>
        
        <!-- Resources -->
        <div class="flex flex-wrap gap-4 text-sm opacity-60">
          <a href="/rss.xml" class="link">rss</a>
          <a href="/sitemap.xml" class="link">sitemap</a>
        </div>
      </div>
    </div>
    
    <!-- Bottom Bar -->
    <div class="mt-12 pt-8 border-t flex flex-col md:flex-row justify-between items-center gap-4 text-sm" style="border-color: rgba(255, 255, 255, 0.1);">
      <p class="opacity-60 flex items-center gap-2">
        © {currentYear} nagaraj pandith. built with 
        <a href="https://astro.build" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 hover:opacity-80 transition-opacity">
          <svg class="w-4 h-4" viewBox="0 0 256 366" fill="currentColor">
            <path d="M182.022 9.147c2.982 3.702 4.502 8.697 7.543 18.687L256 246.074a276.467 276.467 0 0 0-79.426-26.891L133.318 73.008a5.63 5.63 0 0 0-10.802.017L79.784 219.11A276.453 276.453 0 0 0 0 246.04L66.76 27.783c3.051-9.972 4.577-14.959 7.559-18.654a24.541 24.541 0 0 1 9.946-7.358C88.67 0 93.885 0 104.314 0h47.683c10.443 0 15.664 0 20.074 1.774a24.545 24.545 0 0 1 9.95 7.373Z"/>
