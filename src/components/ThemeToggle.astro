<button
  class="theme-toggle p-2 rounded-full hover:bg-[var(--color-bg-secondary)] transition-all cursor-pointer border-none bg-transparent flex items-center justify-center text-[var(--color-text-primary)]"
  aria-label="Toggle theme"
>
  <svg class="sun-icon w-5 h-5 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path>
  </svg>
  <svg class="moon-icon w-5 h-5 hidden transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path>
  </svg>
</button>

<script>
  function setupThemeToggle() {
    const buttons = document.querySelectorAll('.theme-toggle');
    const sunIcons = document.querySelectorAll('.sun-icon');
    const moonIcons = document.querySelectorAll('.moon-icon');
    
    // Initialize theme - default to dark mode
    let currentTheme = localStorage.getItem('theme');
    if (!currentTheme) {
        currentTheme = 'dark';
        localStorage.setItem('theme', 'dark');
    }
    updateThemeUI(currentTheme);
    
    buttons.forEach(button => {
      button.addEventListener('click', (e) => {
        e.preventDefault();
        const newTheme = document.body.classList.contains('light') ? 'dark' : 'light';
        updateThemeUI(newTheme);
        localStorage.setItem('theme', newTheme);
      });
    });

    function updateThemeUI(theme: string) {
      if (theme === 'light') {
        document.body.classList.add('light');
        sunIcons.forEach(icon => icon.classList.remove('hidden'));
        moonIcons.forEach(icon => icon.classList.add('hidden'));
      } else {
        document.body.classList.remove('light');
        sunIcons.forEach(icon => icon.classList.add('hidden'));
        moonIcons.forEach(icon => icon.classList.remove('hidden'));
      }
    }
  }

  // Run on first load
  setupThemeToggle();

  // Re-run on view transitions if you use them
  document.addEventListener('astro:after-swap', setupThemeToggle);
</script>

<style>
  .theme-toggle:hover svg {
    transform: rotate(15deg);
  }
</style>