</BaseLayout>

<style>
  body.light #filter-bar {
    background-color: rgba(250, 248, 243, 0.8) !important;
    border-color: rgba(62, 39, 35, 0.1) !important;
  }

  body:not(.light) #filter-bar {
    background-color: rgba(0, 0, 0, 0.8) !important;
    border-color: rgba(255, 255, 255, 0.1) !important;
  }

  .filter-chip {
    padding: 0.5rem 1rem;
    border-radius: 9999px;
    font-size: 0.875rem;
    transition: all 0.2s;
    background-color: rgba(0, 0, 0, 0.05);
    cursor: pointer;
  }

  .filter-chip:hover {
    opacity: 0.7;
  }

  .filter-chip.active {
    background-color: var(--color-dark-text);
    color: var(--color-dark-bg);
  }
  
  body.light .filter-chip.active {
    background-color: var(--color-light-text);
    color: var(--color-light-bg);
  }

  body:not(.light) .filter-chip {
    background-color: rgba(255, 255, 255, 0.05);
  }

  body:not(.light) .filter-chip.active {
    color: var(--color-dark-bg);
  }

  /* Masonry layout for shots */
  .columns-1 {
    column-count: 1;
  }
  
  @media (min-width: 640px) {
    .columns-2 {
      column-count: 2;
    }
  }
  
  @media (min-width: 1024px) {
    .columns-3 {
      column-count: 3;
    }
  }
</style>

<script>
  // Filter functionality
  const filterChips = document.querySelectorAll('.filter-chip');
  const sections = document.querySelectorAll('.section-content');
  const shuffleBtn = document.getElementById('shuffle-btn');
  
  let currentFilter = 'projects';

  filterChips.forEach(chip => {
    chip.addEventListener('click', () => {
      const filter = chip.getAttribute('data-filter');
      if (!filter) return;
      currentFilter = filter;
      
      // Update active state
      filterChips.forEach(c => c.classList.remove('active'));
      chip.classList.add('active');
      
      // Show/hide sections
      sections.forEach(section => {
        if (section.id === `${filter}-section`) {
          section.classList.remove('hidden');
        } else {
          section.classList.add('hidden');
        }
      });
    });
  });

  // Shuffle functionality
  shuffleBtn?.addEventListener('click', () => {
    const activeSection = document.getElementById(`${currentFilter}-section`);
    if (!activeSection) return;

    const items = Array.from(activeSection.querySelectorAll('[data-index]'));
    
    // Shuffle array
    for (let i = items.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      const temp = items[i];
      items[i] = items[j];
      items[j] = temp;
    }

    // Re-append in shuffled order
    const container = items[0]?.parentElement;
    if (container) {
      items.forEach(item => {
        container.appendChild(item);
      });
    }

    // Visual feedback
    shuffleBtn.style.transform = 'rotate(180deg)';
    setTimeout(() => {
      shuffleBtn.style.transform = 'rotate(0deg)';
    }, 300);
  });

  // Sticky filter bar shadow on scroll
  const filterBar = document.getElementById('filter-bar');
  window.addEventListener('scroll', () => {
    if (window.scrollY > 100) {
      filterBar?.classList.add('shadow-lg');
    } else {
      filterBar?.classList.remove('shadow-lg');
    }
  });
</script>